#!/bin/sh
# Mount the frontend card (the SD slot) on /mnt/SDCARD. Exit 0 when mounted.
# vfat first, then exFAT; one fsck.fat -a and retry if vfat refuses.
. /usr/lib/basedos/functions
SD=/mnt/SDCARD
grep -q " $SD " /proc/mounts && exit 0

dev=""
for d in /dev/mmcblk1p1 /dev/mmcblk1; do [ -b "$d" ] && { dev=$d; break; }; done
[ -n "$dev" ] || { [ -n "${QUIET:-}" ] || log "no card in the slot"; exit 1; }

# A FAT32 card that wasn't unmounted cleanly still has bit 0 of the boot sector's state byte
# (0x41) set, as Linux's vfat leaves it while mounted. Repair it before use.
fat_dirty() {
	[ "$(dd if="$1" bs=1 skip=82 count=5 2>/dev/null)" = FAT32 ] || return 1
	[ $(( $(dd if="$1" bs=1 skip=65 count=1 2>/dev/null | hexdump -e '1/1 "%u"') % 2 )) -eq 1 ]
}
if fat_dirty "$dev"; then
	say "card was not unmounted cleanly; checking it"
	if fsck.fat -a "$dev" >> "$BASEDOS_LOG" 2>&1; then log "fsck.fat: no errors"; else log "fsck.fat exited $? (repairs logged above)"; fi
fi

try() {
	mount -t vfat -o rw,noatime,utf8,shortname=mixed,errors=continue "$dev" "$SD" 2>/dev/null ||
	mount -t exfat -o rw,noatime,iocharset=utf8 "$dev" "$SD" 2>/dev/null
}
if ! try; then
	log "mount of $dev failed; running fsck.fat -a"
	fsck.fat -a "$dev" >> "$BASEDOS_LOG" 2>&1
	try || { log "can't mount $dev"; exit 1; }
fi
say "card $dev on $SD ($(grep " $SD " /proc/mounts | cut -d' ' -f3))"
mark card
exit 0
