#!/usr/bin/python3
"""Exit 0 if all the given keys are held right now on the named input device.

  basedos-keyheld <evdev name> <key code>...      e.g. basedos-keyheld gkd_atom_joypad 314

Reads the key state with EVIOCGKEY, so a key that was already down before anything listened
still counts. Exit 1 if not all held, 2 if the device isn't found.
"""
import array
import fcntl
import glob
import os
import sys


def main():
    if len(sys.argv) < 3:
        sys.exit(__doc__)
    name, codes = sys.argv[1], [int(c) for c in sys.argv[2:]]
    for d in sorted(glob.glob("/sys/class/input/event*")):
        try:
            with open(d + "/device/name") as f:
                if f.read().strip() == name:
                    dev = "/dev/input/" + os.path.basename(d)
                    break
        except OSError:
            continue
    else:
        sys.exit(2)
    state = array.array("B", bytes(96))  # KEY_MAX is 0x2ff: 768 bits
    eviocgkey = (2 << 30) | (len(state) << 16) | (ord("E") << 8) | 0x18
    with open(dev, "rb") as f:
        fcntl.ioctl(f, eviocgkey, state, True)
    sys.exit(0 if all(state[c // 8] >> (c % 8) & 1 for c in codes) else 1)


if __name__ == "__main__":
    main()
