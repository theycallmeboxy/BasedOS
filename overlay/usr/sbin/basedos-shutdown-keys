#!/usr/bin/python3
"""Hold Volume Up and Volume Down together for 3 s: BasedOS's own clean shutdown, whatever the
frontend is doing (rcK: every process asked to quit, 3 s to save, then killed; sync; the card
unmounted or remounted read-only). The way out of a hung frontend short of the PMIC's power cut.
Holding power is left to the frontend.

It asks the keys' state (EVIOCGKEY) instead of reading their events: a frontend may grab an
input device for itself (spruce grabs the power key so RetroArch never sees it), and a grab hides
the events from every other reader, but not the state. The keys are found by what each device
reports (EVIOCGBIT), not by its name. Once a second while the combo isn't held, every 0.2 s
while it is: a few microseconds of CPU per look. Monotonic time stops in suspend."""
import fcntl
import glob
import os
import subprocess
import time

HOLD = 3.0
KEYS = (115, 114)  # KEY_VOLUMEUP, KEY_VOLUMEDOWN
NBYTES = 96  # KEY_MAX / 8 + 1


def ioc_read(nr, size):
    return (2 << 30) | (size << 16) | (ord("E") << 8) | nr


EVIOCGKEY = ioc_read(0x18, NBYTES)          # keys down now
EVIOCGBIT_KEY = ioc_read(0x20 + 1, NBYTES)  # keys the device has (EV_KEY)


def bit(buf, code):
    return bool(buf[code // 8] & (1 << code % 8))


def sh(cmd, *args):
    """A BasedOS shell helper (log, say) with its arguments."""
    subprocess.run(["sh", "-c", ". /usr/lib/basedos/functions; " + cmd + ' "$@"',
                    "basedos-shutdown-keys", *args])


def open_keys():
    """{key code: open device} for each of KEYS, from the first device that has it."""
    found = {}
    for path in sorted(glob.glob("/dev/input/event*")):
        try:
            dev = open(path, "rb")
            caps = bytearray(NBYTES)
            fcntl.ioctl(dev, EVIOCGBIT_KEY, caps, True)
        except OSError:
            continue
        mine = [k for k in KEYS if k not in found and bit(caps, k)]
        if not mine:
            dev.close()
            continue
        for k in mine:
            found[k] = dev
    return found


def main():
    devs = open_keys()
    if len(devs) != len(KEYS):
        sh("log", "no volume keys; the shutdown combo is off")
        return
    sh("log", f"watching the volume keys (hold both {HOLD:g} s to shut down)")
    state = bytearray(NBYTES)

    def held():
        for k, dev in devs.items():
            fcntl.ioctl(dev, EVIOCGKEY, state, True)
            if not bit(state, k):
                return False
        return True

    while True:
        if not held():
            time.sleep(1)
            continue
        start = time.monotonic()
        while held():
            if time.monotonic() - start >= HOLD:
                sh("say", f"volume up + down held {HOLD:g} s: shutting down")
                subprocess.run(["poweroff"])
                return
            time.sleep(0.2)


if __name__ == "__main__":
    while True:  # never leave the session without the way out
        try:
            main()
            break
        except Exception as e:
            sh("log", f"error: {e}; restarting")
            time.sleep(1)
