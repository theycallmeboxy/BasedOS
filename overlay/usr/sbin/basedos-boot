#!/bin/sh
# basedos-boot: leave BasedOS for stock, for one boot, until enabled again, or for good.
#
#   basedos-boot stock-once     reboot into stock once; the boot after is BasedOS again ("Disable
#                               BasedOS" and "Uninstall BasedOS" are in stock's Ports meanwhile)
#   basedos-boot disable        stock's boot script back, and an "Enable BasedOS" script in
#                               stock's Ports, which puts BasedOS's back and reboots into it
#                               ("Uninstall BasedOS" is there too). BasedOS's files stay, for
#                               that. (Formerly switch-to-stock, still accepted.) Stock's Ports
#                               has its own "Disable BasedOS", which does the same from stock.
#   basedos-boot uninstall      stock's boot script back and BasedOS removed: its folder on p1
#                               (basedos/) and its data on p2 (basedos-data/, with the return
#                               script if there is one). Stock is as it was before the install.
#                               Done at the next start, by BasedOS's initrd, when none of these
#                               files are in use; --reboot starts it.
#   basedos-boot status         what boots next, and what's installed
#   ... --reboot                restart once it has worked
#
# The maintenance menu (basedos-menu) and the Start boot key call these.
# install-dev.sh, which installed BasedOS, changed only these: it kept stock's boot.scr as
# boot.scr.stock beside it and wrote BasedOS's own; stock's SYSTEM, kernel, DTBs and /storage are
# untouched.
#
# Caution, since a wrong boot.scr is the one thing here that can stop the device booting:
# - Every boot.scr written is checked first (a well-formed U-Boot script image; BasedOS's or
#   stock's, as expected; stock's matched against the known stock builds when it can be) and
#   read back from the eMMC after.
# - Each write is <name>.new, synced, re-read and compared, then renamed: a power cut leaves the
#   old or the new file whole.
# - The boot.scr switch is the last step that can fail: everything a switch needs (the return
#   script, BasedOS's saved script) is in place and checked before it, and removals come only
#   after it.
# - Nothing is done unless /boot and p2 are the boot disk's (the eMMC on an eMMC install).
export PATH=/usr/bin:/usr/sbin
. /usr/lib/basedos/functions

B=/boot/basedos
P2=/run/p2
ENABLE_NAME="Enable BasedOS.sh"
DISABLE_NAME="Disable BasedOS.sh"
UNINSTALL_NAME="Uninstall BasedOS.sh"
OLD_RETURN_NAME="Return to BasedOS.sh"
KNOWN_STOCK=/usr/share/basedos/stock-boot-scr.sha256
# Stock's own boot script, kept beside its place (outside BasedOS's folder) while BasedOS's is there.
SS=/boot/boot.scr.stock

die() { log "boot: $*"; echo "basedos-boot: $*" >&2; exit 1; }

put() {
	cp "$1" "$2.new" || { rm -f "$2.new"; return 1; }
	sync
	echo 3 > /proc/sys/vm/drop_caches
	cmp -s "$1" "$2.new" || { rm -f "$2.new"; return 1; }
	mv "$2.new" "$2" && sync
}

_made_rw=""
rw() {
	grep -q "^$BOOT_P1 /boot [^ ]* rw" /proc/mounts && return 0
	mount -o remount,rw /boot || die "can't write p1"
	_made_rw=1
}
ro() { sync; [ -n "$_made_rw" ] && mount -o remount,ro /boot; _made_rw=""; }

# scr_kind <file>: basedos, stock or bad. A U-Boot legacy script image (magic 27051956, type 6
# "script", its size as the header says); BasedOS's has rdinit=/basedos/init.
scr_kind() {
	[ -s "$1" ] || { echo bad; return; }
	[ "$(dd if="$1" bs=4 count=1 2>/dev/null | od -An -tx1 | tr -d ' \n')" = 27051956 ] || { echo bad; return; }
	[ "$(dd if="$1" bs=1 skip=30 count=1 2>/dev/null | od -An -tu1 | tr -d ' \n')" = 6 ] || { echo bad; return; }
	_len=$(dd if="$1" bs=1 skip=12 count=4 2>/dev/null | od -An -tu1 | awk '{print (($1*256+$2)*256+$3)*256+$4}')
	[ "$(stat -c %s "$1")" -eq $((_len + 64)) ] || { echo bad; return; }
	if dd if="$1" bs=64 skip=1 2>/dev/null | grep -q "rdinit=/basedos/init"; then echo basedos; else echo stock; fi
}

# check_stock <file>: 0 if it's a stock script; says whether it's a known stock build.
check_stock() {
	[ "$(scr_kind "$1")" = stock ] || return 1
	if grep -q "^$(sha256sum < "$1" | cut -c1-64)" "$KNOWN_STOCK" 2>/dev/null; then
		log "boot: $1 is a known stock build's boot.scr"
	else
		log "boot: $1 is a stock-looking boot.scr but not a known stock build's (stock updated?)"
	fi
}

# The device's own partitions, nothing else.
check_places() {
	grep -q "^$BOOT_P1 /boot " /proc/mounts || die "/boot isn't the boot disk's p1 ($BOOT_P1)"
	[ -d $B ] || die "no $B"
	grep -q "^$BOOT_P2 $P2 " /proc/mounts || die "the boot disk's p2 ($BOOT_P2) isn't mounted at $P2"
}

# Stock's Ports, as stock reads it: its automount sets /storage/roms up at every start, by its
# setting system.merged.device. "internal" binds games-internal/roms on its data partition (p2);
# "external" binds the card's roms folder, and with a spruce card (its folder is "Roms", and the
# lookup is case-sensitive) nothing is bound, so stock shows p2's own roms (seen 2026-11-22, after
# a recovery-card restore had reset the setting). So the entries go to both p2 places, never to
# the card. Not Tools (/storage/.config/modules, which stock rsyncs with --delete from its image
# at every boot).
STOCK_PORTS="$P2/games-internal/roms/ports $P2/roms/ports"
# Older places BasedOS put its entries, cleaned up wherever they go.
OLD_PLACES="$P2/.config/modules"

# stock_entries <name>...: those of "Enable BasedOS", "Disable BasedOS" and "Uninstall BasedOS"
# (/usr/share/basedos/stock/) into stock's Ports (both places), each written, read back and
# renamed; BasedOS's other entries there go (they'd do the wrong thing now), and the older "Return
# to BasedOS". 0 if all are written.
STOCK_FILES=/usr/share/basedos/stock
stock_entries() {
	for _d in $STOCK_PORTS; do
		mkdir -p "$_d" || return 1
		for _f in "$ENABLE_NAME" "$DISABLE_NAME" "$UNINSTALL_NAME" "$OLD_RETURN_NAME"; do
			case " $* " in *" $_f "*) ;; *) rm -f "$_d/$_f" ;; esac
		done
		for _f in "$@"; do
			cp "$STOCK_FILES/$_f" "$_d/$_f.new" && chmod 755 "$_d/$_f.new" && sync &&
				cmp -s "$STOCK_FILES/$_f" "$_d/$_f.new" && mv "$_d/$_f.new" "$_d/$_f" && sync ||
				{ rm -f "$_d/$_f.new"; return 1; }
		done
	done
	for _o in $OLD_PLACES; do rm -f "$_o/$OLD_RETURN_NAME" "$_o/$ENABLE_NAME"; done
}
# no_entry <name>: that entry gone from stock's Ports.
no_entry() { for _d in $STOCK_PORTS; do rm -f "$_d/$1"; done; sync; }

stock_once() {
	# The flag must be on p2: /data in RAM (p2 unusable this boot) would lose it.
	grep -q "^$BOOT_P2 /data " /proc/mounts || die "/data isn't on the boot disk this boot; can't leave the flag"
	: > /data/boot-stock-once && sync && [ -f /data/boot-stock-once ] || die "couldn't write /data/boot-stock-once"
	# Stock's Ports gets "Disable BasedOS" and "Uninstall BasedOS" (the second for an install made
	# before setup put it there).
	grep -q "^$BOOT_P2 $P2 " /proc/mounts && stock_entries "$DISABLE_NAME" "$UNINSTALL_NAME" ||
		log "boot: couldn't put '$DISABLE_NAME' and '$UNINSTALL_NAME' in stock's Ports"
	log "boot: stock for the next boot"
}

disable() {
	check_places
	[ "$(scr_kind /boot/boot.scr)" = basedos ] || die "/boot/boot.scr isn't BasedOS's; nothing to disable"
	check_stock $SS || die "$SS isn't a stock boot script; not disabling"
	# 1. The way back (and "Uninstall BasedOS"), written and read back before anything that boots
	# changes.
	stock_entries "$ENABLE_NAME" "$UNINSTALL_NAME" || die "couldn't write '$ENABLE_NAME' in stock's Ports; not disabling"
	undo_return() { no_entry "$ENABLE_NAME"; }
	rw
	put /boot/boot.scr $B/boot.scr.basedos && [ "$(scr_kind $B/boot.scr.basedos)" = basedos ] ||
		{ ro; undo_return; die "couldn't save BasedOS's boot script; not disabling"; }
	# 2. The switch. On a failure, BasedOS's script goes back (put keeps the old file whole until
	# the rename, so boot.scr is one or the other either way).
	put $SS /boot/boot.scr && cmp -s $SS /boot/boot.scr || {
		cmp -s $B/boot.scr.basedos /boot/boot.scr || put $B/boot.scr.basedos /boot/boot.scr
		rm -f $B/boot.scr.basedos; ro; undo_return
		die "couldn't write stock's boot script; still BasedOS"
	}
	ro
	log "boot: BasedOS disabled (its files stay; '$ENABLE_NAME' in stock's Ports enables it)"
}

uninstall() {
	check_places
	check_stock $SS || die "$SS isn't a stock boot script; not uninstalling"
	grep -q "^$BOOT_P2 /data " /proc/mounts || die "/data isn't on the boot disk this boot; can't leave the flag"
	# The removal itself happens at the restart, in BasedOS's initrd, before anything is mounted
	# from these files: removing a running system's files leaves them half freed (stock's fsck
	# then finds them as FSCK*.REC on p1) and some can't go at all (/etc/passwd, bound from
	# /data). Here: everything checked, and the flag left with the SHA-256 of the stock boot
	# script that was checked, which the initrd puts back only if it's still that file.
	_sha=$(sha256sum < $SS | cut -c1-64)
	echo "$_sha" > /data/uninstall.new && sync && mv /data/uninstall.new /data/uninstall && sync &&
		[ "$(head -c 64 /data/uninstall)" = "$_sha" ] || { rm -f /data/uninstall /data/uninstall.new; die "couldn't leave the uninstall flag"; }
	rm -f /data/boot-stock-once
	log "boot: uninstall at the next start (stock's boot script back, then basedos/ and basedos-data/ removed)"
}

status() {
	case "$(scr_kind /boot/boot.scr)" in
	basedos)
		if [ -f /data/uninstall ]; then echo "next boot: BasedOS UNINSTALLS itself, then stock"
		else echo "next boot: BasedOS$( [ -f /data/boot-stock-once ] && echo ", except: stock once")"; fi ;;
	stock) echo "next boot: stock (BasedOS disabled; '$ENABLE_NAME' in stock's Ports enables it)" ;;
	*) echo "next boot: /boot/boot.scr DOESN'T LOOK LIKE A BOOT SCRIPT" ;;
	esac
	if check_stock $SS; then echo "stock's boot script: saved"; else echo "stock's boot script: NOT saved or not valid"; fi
	echo "system: BasedOS $BASEOS_VERSION ($BASEOS_BUILD)"
	[ -f $B/rootfs.new ] && echo "update: installed, put in place at the next start"
	echo "initrd interface: $(initrd_abi)"
}

case "${1:-}" in
stock-once) stock_once ;;
disable|switch-to-stock) disable ;;
uninstall) uninstall ;;
status) status; exit 0 ;;
*) echo "usage: basedos-boot stock-once|disable|uninstall|status [--reboot]" >&2; exit 2 ;;
esac
if [ "${2:-}" = --reboot ]; then
	say "Restarting..." "restarting"
	reboot
fi
