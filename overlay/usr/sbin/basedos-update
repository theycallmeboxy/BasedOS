#!/bin/sh
# BasedOS system update from a .bosupd at the root of the frontend card (tools/mkupdate.py), named
# as spruce's firmware updater expects of a BaseOS (baseos-<target>-<version>.bosupd).
#
# An update is installed only when asked for: from the frontend (spruce's firmware update app on
# BasedOS runs `basedos-update request`, then reboots) or from the maintenance menu ("Update").
# A .bosupd that's just on the card is left alone.
#
#   request   the frontend: install at the next boot (a mark in /data/update, used once).
#   apply     install the first applicable payload (newer than the running one, not installed
#             before) and reboot into it: frontend-session at boot, when requested. Returns 10 once
#             the reboot is under way.
#   list      the maintenance menu's list: one line per payload on the card,
#             <path>|<build>|<new, old or no>|<why not, for no>.
#   install <payload>
#             the maintenance menu: install that payload, older ones too (picked by hand), and
#             reboot into it (as apply).
#   status    what is installed, and what each payload on the card would do.
#
# A payload carries the system layer, never stock's files, and not BasedOS's boot files either
# (boot.scr and the initrd: setup installs them). It names the stock build its links into /stock
# are made against (its BUILD_ID; docs/plan.md, Architecture) and the initrd interface it needs
# (needs-initrd); a payload for another stock build, or one this device's initrd is too old for,
# is refused. (An initrd in an older payload is left out.)
#
# BasedOS has one system layer (basedos/rootfs.squashfs), in use while it runs, so an update can't
# replace it here: it's written beside it as rootfs.new (as <name>.new first, synced, re-read from
# the eMMC against the manifest's SHA-256, then renamed), and the initrd puts it in place at the
# restart, before mounting it. A power cut before that leaves the running version, with rootfs.new
# waiting. One that never reaches userspace sends the device to stock after three tries (the
# initrd's boot counter); setup, run from stock, repairs BasedOS.
#
# A payload that won't be applied is set aside on the card (renamed <name>.bosupd.skipped,
# .refused or .failed), so neither this nor spruce's updater keeps offering or retrying it.
export PATH=/usr/bin:/usr/sbin
. /usr/lib/basedos/functions

FORMAT=basedos-update/1
CARD=/mnt/SDCARD
B=/boot/basedos
STATE_DIR=/data/update
HISTORY=$STATE_DIR/history
MANIFEST=/run/basedos/bosupd-manifest
REQUEST=$STATE_DIR/requested

field() { sed -n "s/^$2=//p" "$1" 2>/dev/null | head -1; }

# 0 if dotted version $1 is newer than $2 (missing fields count as 0). A -suffix is a pre-release
# of its own version, older than the release; two pre-releases of one version compare by their
# dotted suffixes (pre.9 is newer than pre.8; numbers as numbers, words as words).
version_newer() {
	_a=${1%%-*} _b=${2%%-*}
	while [ -n "$_a$_b" ]; do
		_x=${_a%%.*} _y=${_b%%.*}
		case "$_a" in *.*) _a=${_a#*.} ;; *) _a="" ;; esac
		case "$_b" in *.*) _b=${_b#*.} ;; *) _b="" ;; esac
		case "$_x" in ''|*[!0-9]*) _x=0 ;; esac
		case "$_y" in ''|*[!0-9]*) _y=0 ;; esac
		[ "$_x" -gt "$_y" ] && return 0
		[ "$_x" -lt "$_y" ] && return 1
	done
	case "$1" in *-*) ;; *) case "$2" in *-*) return 0 ;; *) return 1 ;; esac ;; esac
	case "$2" in *-*) ;; *) return 1 ;; esac
	_a=${1#*-} _b=${2#*-}
	while [ -n "$_a$_b" ]; do
		_x=${_a%%.*} _y=${_b%%.*}
		case "$_a" in *.*) _a=${_a#*.} ;; *) _a="" ;; esac
		case "$_b" in *.*) _b=${_b#*.} ;; *) _b="" ;; esac
		[ -z "$_x" ] && return 1
		[ -z "$_y" ] && return 0
		[ "$_x" = "$_y" ] && continue
		case "$_x$_y" in
		*[!0-9]*) [ "$(printf '%s\n%s\n' "$_x" "$_y" | sort | tail -1)" = "$_x" ]; return ;;
		*) [ "$_x" -gt "$_y" ]; return ;;
		esac
	done
	return 1
}

# release_name <build>: a release build's name without its v (v0.0.1-pre.8 -> 0.0.1-pre.8);
# nothing for a development build (git describe past a tag: v0.0.1-pre.8-3-g1234abc, or -dirty).
release_name() {
	_r=${1#v}
	[ "$_r" != "$1" ] || return 0
	case "$_r" in ''|*-*-*|*dirty*) return 0 ;; esac
	case "${_r%%-*}" in ''|*[!0-9.]*) return 0 ;; esac
	case "$_r" in *-*) case "${_r#*-}" in ''|*[!a-z0-9.]*) return 0 ;; esac ;; esac
	echo "$_r"
}

# Judge one payload: 0 = apply, 1 = nothing to do (not newer, or installed before: it can still
# be installed by hand), 2 = refused. Sets EV_VERSION, EV_BUILD, EV_SHA, EV_REASON (for the log),
# EV_WHY (for the screen, when refused), and leaves its manifest in $MANIFEST.
evaluate() {
	EV_VERSION="" EV_BUILD="" EV_SHA="" EV_REASON="" EV_STOCK="" EV_WHY="not for this device"
	if ! tar -xOf "$1" manifest > "$MANIFEST" 2>/dev/null || [ ! -s "$MANIFEST" ]; then
		EV_REASON="not a BasedOS update"; return 2
	fi
	EV_VERSION=$(field "$MANIFEST" version)
	EV_BUILD=$(field "$MANIFEST" build)
	EV_SHA=$(field "$MANIFEST" rootfs-sha256)
	[ "$(field "$MANIFEST" format)" = "$FORMAT" ] || { EV_REASON="format $(field "$MANIFEST" format), not $FORMAT"; return 2; }
	[ "$(field "$MANIFEST" target)" = "$BASEOS_TARGET" ] || { EV_REASON="built for $(field "$MANIFEST" target), this is $BASEOS_TARGET"; return 2; }
	case "$EV_SHA" in [0-9a-f][0-9a-f][0-9a-f][0-9a-f]*) ;; *) EV_REASON="no rootfs-sha256"; return 2 ;; esac
	EV_STOCK=$(field "$MANIFEST" stock)
	EV_WHY="made for another stock version"
	[ -n "$EV_STOCK" ] || { EV_REASON="names no stock build (made for an older BasedOS)"; return 2; }
	[ "$EV_STOCK" = "${BASEOS_STOCK_BUILD_ID:-}" ] ||
		{ EV_REASON="made for stock build $EV_STOCK; this device's is ${BASEOS_STOCK_BUILD_ID:-unknown}"; return 2; }
	EV_WHY="needs a newer BasedOS install"
	_need=$(field "$MANIFEST" needs-initrd)
	case "$_need" in ''|*[!0-9]*) _need=1 ;; esac
	[ "$_need" -le "$(initrd_abi)" ] ||
		{ EV_REASON="needs a newer BasedOS initrd (interface $_need; this device's has $(initrd_abi)), which comes with setup"; return 2; }
	EV_WHY=""
	# Only forward: an old payload left on the card must not downgrade the device once it has moved
	# past it. Two releases compare by their release names (pre-releases of one version included);
	# otherwise a newer version, or a development rebuild of the running version.
	_ev_rel=$(release_name "$EV_BUILD") _run_rel=$(release_name "${BASEOS_BUILD:-}")
	if [ -n "$_ev_rel" ] && [ -n "$_run_rel" ]; then
		version_newer "$_ev_rel" "$_run_rel" ||
			{ EV_REASON="not newer than the running $BASEOS_VERSION ($BASEOS_BUILD)"; return 1; }
	elif version_newer "$EV_VERSION" "${BASEOS_VERSION:-0}"; then :
	elif [ "$EV_VERSION" = "$BASEOS_VERSION" ] && [ "$EV_BUILD" != "$BASEOS_BUILD" ]; then :
	else EV_REASON="not newer than the running $BASEOS_VERSION ($BASEOS_BUILD)"; return 1
	fi
	grep -q "^$EV_SHA " "$HISTORY" 2>/dev/null && { EV_REASON="already applied once"; return 1; }
	EV_REASON="ready"
	return 0
}

# member <payload> <member> <dest> <sha256>: write, sync, drop the cache, re-read, rename.
member() {
	tar -xOf "$1" "$2" > "$3.new" 2>/dev/null || { rm -f "$3.new"; return 1; }
	sync
	echo 3 > /proc/sys/vm/drop_caches
	[ "$(sha256sum < "$3.new" | cut -d' ' -f1)" = "$4" ] || { rm -f "$3.new"; return 1; }
	mv "$3.new" "$3" && sync
}

# set_aside <payload> <skipped|refused|failed> <why>: rename it out of the *.bosupd glob, so it isn't
# looked at (or offered by spruce) again.
set_aside() {
	if mv -f "$1" "$1.$2" 2>/dev/null; then log "$1 $2 ($3); renamed to ${1##*/}.$2"
	else log "$1 $2 ($3); couldn't rename it"; fi
}

apply() {
	_found=""
	for _p in "$CARD"/*.bosupd; do [ -f "$_p" ] && _found=1 && break; done
	[ -n "$_found" ] || return 0
	mkdir -p "$STATE_DIR" || { log "can't write $STATE_DIR; not updating"; return 1; }
	_chosen=""
	for _p in "$CARD"/*.bosupd; do
		[ -f "$_p" ] || continue
		evaluate "$_p"; _r=$?
		case $_r in
		0) _chosen=$_p; break ;;
		1) set_aside "$_p" skipped "$EV_REASON" ;;
		*) set_aside "$_p" refused "$EV_REASON" ;;
		esac
	done
	[ -n "$_chosen" ] || return 0
	install_image "$_chosen"
}

# install_image <payload>: write an evaluated payload's (EV_*) system layer as rootfs.new, record it,
# remove the payload and reboot (returns 10); the initrd puts it in place.
install_image() {
	say "Installing $EV_BUILD..." "installing $EV_VERSION ($EV_BUILD) from $1"
	mount -o remount,rw /boot || { log "can't write p1; not updating"; return 1; }
	if ! member "$1" rootfs.squashfs "$B/rootfs.new" "$EV_SHA"; then
		mount -o remount,ro /boot
		set_aside "$1" failed "the system image didn't verify, or didn't fit"
		say "Update failed. BasedOS is unchanged." "update failed: the system image didn't verify; still on $BASEOS_VERSION"
		return 1
	fi
	mount -o remount,ro /boot
	echo "$EV_SHA $EV_VERSION $EV_BUILD" >> "$HISTORY"
	rm -f "$1"
	sync
	say "Update installed. Restarting..." "BasedOS $EV_VERSION ($EV_BUILD) installed (the restart puts it in place); removed $1"
	reboot
	# 10: installed and the reboot asked for (init acts on it); the caller waits for it.
	return 10
}

# list: the maintenance menu's list of payloads on the card (changes nothing on it).
list() {
	for _p in "$CARD"/*.bosupd; do
		[ -f "$_p" ] || continue
		evaluate "$_p"; _r=$?
		case $_r in
		0) echo "$_p|$EV_BUILD|new|" ;;
		1) echo "$_p|$EV_BUILD|old|" ;;
		*) echo "$_p|${EV_BUILD:-${_p##*/}}|no|$EV_WHY" ;;
		esac
	done
}

# install <payload>: the maintenance menu's install, of a payload picked by hand.
install() {
	[ -f "${1:-}" ] || { log "install: no payload '${1:-}'"; return 1; }
	mkdir -p "$STATE_DIR" || { log "can't write $STATE_DIR; not updating"; return 1; }
	evaluate "$1"
	[ $? -le 1 ] || { log "install: $1 refused ($EV_REASON)"; return 1; }
	install_image "$1"
}

# request: the next boot installs the update (once). The frontend calls this before rebooting.
request() {
	mkdir -p "$STATE_DIR" && date > "$REQUEST" && sync && [ -f "$REQUEST" ] ||
		{ log "couldn't leave the update request in $STATE_DIR"; return 1; }
	log "update requested for the next boot"
}

status() {
	echo "running: BasedOS $BASEOS_VERSION ($BASEOS_BUILD), on stock ${BASEOS_STOCK:-?} (${BASEOS_STOCK_BUILD_ID:-?})"
	[ -f "$B/rootfs.new" ] && echo "installed, waiting for the restart: $B/rootfs.new"
	_any=""
	for _p in "$CARD"/*.bosupd; do
		[ -f "$_p" ] || continue
		_any=1
		evaluate "$_p"; _r=$?
		case $_r in
		0) echo "$_p: $EV_VERSION ($EV_BUILD) WILL BE INSTALLED at the next boot" ;;
		1) echo "$_p: $EV_VERSION ($EV_BUILD) skipped: $EV_REASON" ;;
		*) echo "$_p: refused: $EV_REASON" ;;
		esac
	done
	[ -n "$_any" ] || echo "no .bosupd at the root of the card"
}

case "${1:-}" in
request) request ;;
apply) apply ;;
list) list ;;
install) install "${2:-}" ;;
status) status ;;
*) echo "usage: basedos-update request|apply|list|install <payload>|status" >&2; exit 2 ;;
esac
