# Shared helpers for BasedOS scripts. Sourced, not run.
set -a
. /etc/baseos-release
set +a

BASEDOS_LOG=/data/basedos.log

# log "message": one line, tagged with uptime and the calling script.
log() {
	read -r _up _ < /proc/uptime
	_l="[$_up] ${0##*/}: $*"
	if [ -d /data ] && [ -w /data ]; then echo "$_l" >> "$BASEDOS_LOG"; else echo "$_l" >> /run/basedos/early.log; fi
	echo "$_l" > /dev/kmsg 2>/dev/null
}

# The boot screen (/usr/bin/basedos-splash): BasedOS's wordmark, the info lines in
# /run/basedos/splash ('!' first = highlighted) and a status line. It draws to the framebuffer,
# which the panel shows while no frontend owns the display; with a frontend up it's not seen.
SPLASH_INFO=/run/basedos/splash
splash() { [ -x /usr/bin/basedos-splash ] && /usr/bin/basedos-splash "$@" >/dev/null 2>&1; }

# say <screen text> [<log text>]: show a short message as the boot screen's status line, and log
# it (or the details, if given: paths and codes are for the log, not the screen).
say() { log "${2:-$1}"; splash "$1"; }

# The disk BasedOS booted from (boot.scr passes basedos.disk=mmcblkN; the eMMC is mmcblk0): stock's
# boot partition, with BasedOS's folder, is its p1 (/boot); stock's data partition, with /data
# (basedos-data), its p2.
BOOT_DISK=""
for _a in $(cat /proc/cmdline 2>/dev/null); do
	case "$_a" in basedos.disk=mmcblk[0-9]) BOOT_DISK=${_a#basedos.disk=} ;; esac
done
BOOT_DISK=${BOOT_DISK:-mmcblk0}
BOOT_P1=/dev/${BOOT_DISK}p1
BOOT_P2=/dev/${BOOT_DISK}p2

# Which rootfs slot this boot runs: the initrd loop-mounts rootfs.squashfs (a) or
# rootfs-b.squashfs (b) as /, with stock's SYSTEM at its /stock. Read from the loop device
# mounted at /, so a slot image loop-mounted for a look (slot_info) doesn't count.
boot_slot() {
	_d=$(awk '$2 == "/" && $1 ~ /^\/dev\/loop/ { d = $1 } END { print d }' /proc/mounts)
	for _f in ${_d:+/sys/block/${_d#/dev/}/loop/backing_file} /sys/block/loop*/loop/backing_file; do
		case "$(cat "$_f" 2>/dev/null)" in
		*/basedos/rootfs-b.squashfs) echo b; return ;;
		*/basedos/rootfs.squashfs) echo a; return ;;
		esac
	done
	echo "?"
}

# The rootfs slots on p1 (/boot/basedos): slot_image <a|b> is that slot's system layer; next_slot
# the one the initrd boots next (the slot file: b, or anything else for a); point_slot <a|b> sets
# it (p1 must be writable). The initrd's boot counter can still take the other one for a boot.
slot_image() { if [ "$1" = b ]; then echo /boot/basedos/rootfs-b.squashfs; else echo /boot/basedos/rootfs.squashfs; fi; }
next_slot() { if [ "$(head -c 2 /boot/basedos/slot 2>/dev/null | tr -d '\n')" = b ]; then echo b; else echo a; fi; }
point_slot() {
	if [ "$1" = b ]; then
		echo b > /boot/basedos/slot.new && sync && mv /boot/basedos/slot.new /boot/basedos/slot
	else
		rm -f /boot/basedos/slot
	fi && sync
}

# initrd_abi [<initrd.uimg>]: the interface an initrd gives the system layers (its init's ABI),
# from its U-Boot image name, "BasedOS initrd abi N". "BasedOS initrd" alone is 1, the interface
# before it had a number; anything else 0.
initrd_abi() {
	_n=$(dd if="${1:-/boot/basedos/initrd.uimg}" bs=32 skip=1 count=1 2>/dev/null | tr -d '\000')
	case "$_n" in
	"BasedOS initrd abi "*)
		_n=${_n#BasedOS initrd abi }
		case "$_n" in ''|*[!0-9]*) echo 0 ;; *) echo "$_n" ;; esac ;;
	"BasedOS initrd") echo 1 ;;
	*) echo 0 ;;
	esac
}

# slot_info <a|b>: what's in a slot. SI_BUILD is its build (empty if none); SI_FIT is empty if it
# would start on this device, else why not ("empty" when there's no image). The running slot is
# read from /etc; another is loop-mounted read-only for a moment, as the initrd would see it.
slot_info() {
	SI_BUILD="" SI_FIT=""
	_img=$(slot_image "$1")
	[ -f "$_img" ] || { SI_FIT=empty; return 0; }
	if [ "$1" = "$(boot_slot)" ]; then SI_BUILD=$BASEOS_BUILD; return 0; fi
	_m=/run/basedos/slot-$1
	mkdir -p "$_m"
	if ! mount -t squashfs -o ro,loop "$_img" "$_m" 2>/dev/null; then
		rmdir "$_m" 2>/dev/null
		SI_FIT="damaged"
		return 0
	fi
	SI_BUILD=$(sed -n 's/^BASEOS_BUILD=//p' "$_m/etc/baseos-release" 2>/dev/null)
	_stock=$(cat "$_m/usr/share/basedos/needs-stock" 2>/dev/null)
	_need=$(cat "$_m/usr/share/basedos/needs-initrd" 2>/dev/null)
	umount "$_m"
	rmdir "$_m" 2>/dev/null
	case "$_need" in ''|*[!0-9]*) _need=1 ;; esac
	if [ -z "$_stock" ] || [ "$_stock" != "${BASEOS_STOCK_BUILD_ID:-}" ]; then
		SI_FIT="made for another stock version"
	elif [ "$_need" -gt "$(initrd_abi)" ]; then
		SI_FIT="needs a newer BasedOS install"
	fi
	return 0
}

# slot_line <a|b> [<separator>]: one line on a slot, for basedos-boot status and the maintenance
# menu ("Slot A: ..."; the menu passes ":<TAB>", the boot screen's key-value form).
slot_line() {
	slot_info "$1"
	_sep=${2:-: } _what=""
	[ "$1" = "$(boot_slot)" ] && _what="running"
	[ "$1" = "$(next_slot)" ] && _what="${_what:+$_what, }boots next"
	case "$SI_FIT" in
	empty) echo "Slot $(echo "$1" | tr ab AB)${_sep}empty" ;;
	"") echo "Slot $(echo "$1" | tr ab AB)${_sep}${SI_BUILD:-unknown build}${_what:+  ($_what)}" ;;
	*) echo "Slot $(echo "$1" | tr ab AB)${_sep}${SI_BUILD:+$SI_BUILD, }won't start: $SI_FIT${_what:+  ($_what)}" ;;
	esac
}

# The boot screen's info lines for a normal boot (basedos-splash's line kinds: key<TAB>value,
# @button label).
splash_boot_info() {
	{
		printf 'Version:\t%s\n' "$BASEOS_VERSION"
		printf 'Build:\t%s\n' "$BASEOS_BUILD"
		printf 'Active Slot:\t%s\n' "$(boot_slot | tr ab AB)"
		boot_key_hints
	} > "$SPLASH_INFO"
}

# Maintenance mode's screen: what it is, how to reach it and how to leave. Refreshed when Wi-Fi
# gets an address (udhcpc's default.script).
maintenance_screen() {
	_ip=$(ip -4 addr show wlan0 2>/dev/null | sed -n 's/.*inet \([0-9.]*\).*/\1/p' | head -1)
	{
		echo "!MAINTENANCE MODE"
		if [ -n "$_ip" ]; then printf 'SSH:\troot@%s (no password)\n' "$_ip"; else printf 'SSH:\twaiting for Wi-Fi\n'; fi
	} > "$SPLASH_INFO"
	splash "$@"
}

# Boot keys: a button held at power-on picks this boot's action (frontend-session reads them
# once, on the first session of a boot). The map is /data/boot-keys.conf when there is one,
# else BasedOS's default (only Select: maintenance mode); see that file for the format.
boot_keys_conf() {
	if [ -f /data/boot-keys.conf ]; then echo /data/boot-keys.conf; else echo /usr/share/basedos/boot-keys.conf; fi
}

# button_code <button>: the Linux key code of a button as labelled on the 350H Ultra (its pad
# driver's codes; the volume keys come from gpio-keys).
button_code() {
	case "$1" in
	a) echo 305 ;; b) echo 304 ;; x) echo 307 ;; y) echo 308 ;;
	l1) echo 310 ;; r1) echo 311 ;; l2) echo 312 ;; r2) echo 313 ;;
	select) echo 314 ;; start) echo 315 ;; menu) echo 316 ;; l3) echo 317 ;; f1) echo 704 ;;
	up) echo 544 ;; down) echo 545 ;; left) echo 546 ;; right) echo 547 ;;
	volup) echo 115 ;; voldown) echo 114 ;;
	*) return 1 ;;
	esac
}

# button_label <button>: how the screen names it.
button_label() {
	case "$1" in
	select) echo Select ;; start) echo Start ;; menu) echo Menu ;; f1) echo F1 ;;
	up) echo Up ;; down) echo Down ;; left) echo Left ;; right) echo Right ;;
	volup) echo "Volume Up" ;; voldown) echo "Volume Down" ;;
	*) echo "$1" | tr a-z A-Z ;;
	esac
}

# boot_key_action: "<button> <action> [argument]" for the first line of the map whose button is
# held right now (basedos-keys reads every input device once, a few ms), nothing if none is.
boot_key_action() {
	_held=" $(/usr/bin/basedos-keys 2>/dev/null | tr '\n' ' ') "
	grep -v '^[[:space:]]*\(#\|$\)' "$(boot_keys_conf)" 2>/dev/null | while read -r _b _a _arg; do
		_c=$(button_code "$_b") || continue
		case "$_held" in *" $_c "*) echo "$_b $_a${_arg:+ $_arg}"; break ;; esac
	done
}

# boot_key_hints [maintenance stock ...]: a button label for each mapped button (those actions
# only, if given), for the boot screen: "@<button> <what it does>", which basedos-splash puts
# beside the button itself (Select, Start) or lists.
boot_key_hints() {
	grep -v '^[[:space:]]*\(#\|$\)' "$(boot_keys_conf)" 2>/dev/null | while read -r _b _a _arg; do
		button_code "$_b" >/dev/null || continue
		[ $# -eq 0 ] || case " $* " in *" $_a "*) ;; *) continue ;; esac
		case "$_a" in
		maintenance) _what="Maintenance" ;;
		stock) _what="Boot Stock OS" ;;
		frontend) _what="Start ${_arg##*/}" ;;
		*) _what="$_a" ;;
		esac
		echo "@$_b $_what"
	done | head -3
}

# mark name: record when a boot step happened (/run/basedos/mark-<name> holds the uptime).
mark() { read -r _up _ < /proc/uptime; echo "$_up" > "/run/basedos/mark-$1"; }

# resync_dac_volume: the stock kernel's es9018k2m driver doesn't restore the DAC's registers after
# deep sleep. The chip wakes at its power-on attenuation (0 dB, full volume) while regmap's cache
# keeps the level set before, so a frontend setting that same level again is skipped as
# unchanged (read on the unit 2026-11-18: chip 0x0f = 00, cache ff; keeping vcca3v3_codec on in
# suspend didn't help). Writing a neighbouring value and then the level puts both through.
resync_dac_volume() {
	_ctl='name=Digital Playback Volume'
	_raw=$(amixer cget "$_ctl" 2>/dev/null | sed -n 's/.*: values=\([0-9]*\).*/\1/p')
	[ -n "$_raw" ] || return 0
	if [ "$_raw" -gt 0 ]; then _near=$((_raw - 1)); else _near=1; fi
	# Both writes in one amixer (batch mode reads commands from stdin).
	printf 'cset "%s" %s,%s\ncset "%s" %s,%s\n' "$_ctl" $_near $_near "$_ctl" $_raw $_raw | amixer -q -s
}
