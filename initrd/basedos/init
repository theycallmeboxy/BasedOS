#!/basedos/busybox sh
# BasedOS early init. The kernel (stock's own, from stock's boot partition: boot.scr) unpacks its
# built-in (stock) initramfs and then this one on top. boot.scr passes rdinit=/basedos/init, so
# stock's /init stays untouched: if BasedOS can't come up, we hand over to it and stock boots.
#
# BasedOS runs on stock's own files (docs/plan.md, Architecture): stock's SYSTEM is mounted
# read-only at /stock in BasedOS's root, and the system layer links to the stock files it uses
# there. A system layer is made against one stock build (usr/share/basedos/needs-stock, its
# BUILD_ID); with any other stock it isn't used, and stock boots.
#
# Boot attempts are counted on p2 (basedos-data/boot-attempts) before the root is
# chosen, and rcS deletes the count once userspace is up. Boots that never reach
# rcS keep counting: from the 4th the other rootfs slot is used, from the 6th
# stock boots. The count stays until rcS (or you) deletes it. basedos-data/boot-stock-once,
# if there, is removed and stock boots once.
bb=/basedos/busybox
log() { echo "basedos-init: $*" > /dev/kmsg; }

$bb mkdir -p /proc /sys /dev /newroot /p1 /p2
$bb mount -t proc proc /proc
$bb mount -t sysfs sys /sys
$bb mount -t devtmpfs dev /dev 2>/dev/null

fallback() {
	log "$1; booting stock instead"
	$bb umount /newroot/stock /newroot /p1 /p2 2>/dev/null
	$bb umount /dev /sys /proc 2>/dev/null
	exec /init
}

# The disk boot.scr was loaded from (basedos.disk=mmcblkN; the eMMC is mmcblk0, and an old
# stock-derived boot.scr passes none). Stock's boot partition, with BasedOS's folder in it, is its
# p1; stock's data partition, with basedos-data, its p2. Give p1 up to 5 s.
disk=""
for a in $($bb cat /proc/cmdline); do
	case "$a" in basedos.disk=mmcblk[0-9]) disk=${a#basedos.disk=} ;; esac
done
disk=${disk:-mmcblk0}
i=0
while [ ! -b /dev/${disk}p1 ] && [ $i -lt 50 ]; do $bb usleep 100000; i=$((i + 1)); done
$bb mount -t vfat -o ro,noatime /dev/${disk}p1 /p1 || fallback "can't mount ${disk}p1"
P2=/dev/${disk}p2

attempts=0
if $bb mount -t ext4 -o noatime $P2 /p2 2>/dev/null; then
	$bb mkdir -p /p2/basedos-data
	# Uninstall (basedos-boot uninstall checked everything while BasedOS ran, and left the
	# SHA-256 of the stock boot script it checked): done here, where none of BasedOS's files are
	# in use. Stock's boot script first, only if it's still that file, read back after; then
	# BasedOS's data and folder; then stock boots. Any check failing drops the flag and BasedOS
	# boots as usual. A power cut after the boot script is back leaves leftovers, but stock boots.
	if [ -f /p2/basedos-data/uninstall ]; then
		want=$($bb head -c 64 /p2/basedos-data/uninstall)
		have=$($bb sha256sum < /p1/basedos/boot.scr.stock 2>/dev/null | $bb cut -c1-64)
		if [ ${#want} -eq 64 ] && [ "$want" = "$have" ] && $bb mount -o remount,rw /p1; then
			$bb rm -f /p1/boot.scr.new
			if $bb cp /p1/basedos/boot.scr.stock /p1/boot.scr.new && $bb sync &&
				echo 3 > /proc/sys/vm/drop_caches &&
				[ "$($bb sha256sum < /p1/boot.scr.new | $bb cut -c1-64)" = "$want" ] &&
				$bb mv /p1/boot.scr.new /p1/boot.scr && $bb sync &&
				[ "$($bb sha256sum < /p1/boot.scr | $bb cut -c1-64)" = "$want" ]; then
				$bb rm -f "/p2/.config/modules/Return to BasedOS.sh" "/p2/roms/ports/Return to BasedOS.sh"
				$bb rm -rf /p2/basedos-data
				$bb rm -rf /p1/basedos
				# An older developer update's copy of BasedOS's boot script, beside stock's files.
				$bb grep -q "rdinit=/basedos/init" /p1/boot.scr.prev 2>/dev/null && $bb rm -f /p1/boot.scr.prev
				$bb sync
				$bb mount -o remount,ro /p1
				fallback "BasedOS uninstalled"
			fi
			$bb rm -f /p1/boot.scr.new
			$bb sync
			$bb mount -o remount,ro /p1
			log "uninstall: couldn't write stock's boot script; BasedOS stays"
		else
			log "uninstall: the saved stock boot script isn't the one checked; BasedOS stays"
		fi
		$bb rm -f /p2/basedos-data/uninstall
		$bb sync
	fi
	# Stock for this one boot (basedos-boot stock-once: the Start key, the maintenance menu).
	# The flag goes first, so the boot after this one is BasedOS's again whatever stock does.
	# Honoured only once the flag is really gone: one that can't be removed (p2 read-only after an
	# error) would otherwise send every boot to stock.
	if [ -f /p2/basedos-data/boot-stock-once ]; then
		$bb rm -f /p2/basedos-data/boot-stock-once
		$bb sync
		if [ -f /p2/basedos-data/boot-stock-once ]; then
			log "boot-stock-once can't be removed; ignoring it"
		else
			fallback "stock asked for this boot"
		fi
	fi
	attempts=$($bb cat /p2/basedos-data/boot-attempts 2>/dev/null)
	case "$attempts" in ''|*[!0-9]*) attempts=0 ;; esac
	attempts=$((attempts + 1))
	echo "$attempts" > /p2/basedos-data/boot-attempts
	$bb sync
	$bb umount /p2
else
	log "can't mount $P2; boot attempts not counted"
fi
[ "$attempts" -ge 6 ] && fallback "BasedOS did not reach rcS in the last $((attempts - 1)) boots"

# Slot "b" is rootfs-b.squashfs; anything else (none, empty, garbage) is rootfs.squashfs.
slot=$($bb head -c 2 /p1/basedos/slot 2>/dev/null | $bb tr -d '\n')
[ "$slot" = b ] || slot=""
other=b; [ "$slot" = b ] && other=""
if [ "$attempts" -ge 4 ] && [ -f "/p1/basedos/rootfs${other:+-$other}.squashfs" ]; then
	log "boot attempt $attempts without reaching rcS: trying the other slot"
	slot=$other
fi

# A slot is BasedOS's system layer (rootfs.squashfs or rootfs-b.squashfs), mounted read-only as
# the root, with stock's SYSTEM mounted read-only at its /stock. It's used only if stock is the
# build it was made against (its needs-stock against stock's own BUILD_ID) and it has its tools.
mount_slot() {
	$bb mount -t squashfs -o ro,loop "$1" /newroot || { log "$1 does not mount"; return 1; }
	want=$($bb cat /newroot/usr/share/basedos/needs-stock 2>/dev/null)
	if [ -z "$want" ]; then
		log "$1 names no stock build (an older BasedOS, made for its own vendor set)"
		$bb umount /newroot
		return 1
	fi
	if ! $bb mount -t squashfs -o ro,loop /p1/SYSTEM /newroot/stock; then
		log "stock's SYSTEM does not mount"
		$bb umount /newroot
		return 1
	fi
	have=$($bb sed -n 's/^BUILD_ID="\{0,1\}\([0-9a-f]*\)"\{0,1\}$/\1/p' /newroot/stock/etc/os-release 2>/dev/null)
	if [ "$have" != "$want" ]; then
		log "$1 is made for stock build $want; this stock is ${have:-unknown}"
		$bb umount /newroot/stock /newroot
		return 1
	fi
	# /sbin/init is an absolute link to /usr/bin/busybox, which would resolve against this
	# initramfs (it has a busybox too), so check the real files inside the new root.
	if [ -x /newroot/usr/bin/busybox ] && [ -e /newroot/usr/lib/ld-linux-aarch64.so.1 ]; then
		return 0
	fi
	log "$1 has no /usr/bin/busybox or no C library"
	$bb umount /newroot/stock /newroot 2>/dev/null
	return 1
}

for s in "$slot" "$other"; do
	root=/p1/basedos/rootfs${s:+-$s}.squashfs
	[ -f "$root" ] || { log "no $root"; continue; }
	mount_slot "$root" && break
	root=""
done
[ -n "$root" ] || fallback "no usable rootfs"

log "root $root on stock $have (boot attempt $attempts)"
$bb mkdir -p /newroot/boot 2>/dev/null
$bb mount --move /p1 /newroot/boot 2>/dev/null || $bb mount -o bind /p1 /newroot/boot
$bb mount --move /dev /newroot/dev
$bb umount /sys /proc
exec $bb switch_root /newroot /sbin/init
