#!/recovery/busybox sh
# BasedOS recovery card's init (rdinit=/recovery/init; tools/recovery/boot.cmd starts it with the
# device's own stock kernel). It puts the built-in storage (the eMMC) back from the backup on the
# card:
#
#   1. checks, writing nothing: the card's backup (backup/, by region, described in
#      recovery/backup.info) is this device's eMMC (its ID and size), each region it writes back
#      decompresses to the MD5 recorded when it was made, and the battery has enough charge (or
#      the charger is in);
#   2. shows what it would restore, and restores only once A, B, X and Y are tapped in that order
#      (tapping power powers off, on every screen);
#   3. writes the partition table, p1 and p2 back to the eMMC, each at its sector, checking the
#      MD5 of what it decompressed, then reads each back and checks it again. The bootloader
#      region is left as it is: it's what started this card, so it works, and a restore that
#      never touches it can always be tried again from the card;
#   4. says so, and powers off when power is tapped: take the card out and the device starts from
#      the eMMC as it was when the backup was made.
#
# Only the eMMC is ever written, and only in step 3. The card is mounted read-only.
R=/recovery
bb=$R/busybox
$bb mkdir -p /proc /sys /dev /run/basedos /card /tmp $R/bin
$bb mount -t proc proc /proc
$bb mount -t sysfs sys /sys
$bb mount -t devtmpfs dev /dev 2>/dev/null
$bb --install -s $R/bin
export PATH=$R/bin:$R
set -o pipefail
log() { echo "recovery: $*" > /dev/kmsg; }

# Linux key codes: the pad's A, B, X, Y (as BasedOS's button_code has them) and the power key.
A=305 B=304 X=307 Y=308 POWER=116
INFO=/run/basedos/splash
TAB=$(printf '\t')
# screen <status> <line>...: the boot screen, its lines ('!' first: highlighted) and status.
screen() {
	_s=$1; shift
	printf '%s\n' "$@" > $INFO
	$R/basedos-splash "$_s" >/dev/null 2>&1
}
# Keys come from one basedos-keys --watch per waiting screen, through a FIFO: every press while the
# screen is up is read in order, even while the screen is being redrawn between two of them (a
# fresh reader for each key could miss a tap that fell between two readers).
# listen: a fresh reader (presses from before this screen don't count).
KW=""
listen() {
	[ -n "$KW" ] && { kill $KW 2>/dev/null; wait $KW 2>/dev/null; }
	exec 5<&-
	rm -f /tmp/keys; mkfifo /tmp/keys
	$R/basedos-keys --watch > /tmp/keys 2>/dev/null & KW=$!
	exec 5< /tmp/keys
}
# key [<ms>]: the code of the next key pressed since listen, or nothing if none within <ms> (whole
# seconds, rounded up; 0 or none: wait for one).
key() {
	_k=""
	if [ "${1:-0}" -gt 0 ]; then read -r -t $(( ($1 + 999) / 1000 )) _k <&5
	else read -r _k <&5 || sleep 1; fi
	echo "$_k"
}
off() {
	sync
	screen "Powering off..." "!RECOVERY CARD"
	sleep 1
	poweroff -f
}
# stop <what's wrong> [<details for the log>]: a screen that only offers power off.
stop() {
	log "${2:-$1}"
	screen "Tap power to turn off." "!RECOVERY CARD" "$1" "Nothing was changed."
	listen
	while [ "$(key)" != $POWER ]; do :; done
	off
}
# sequence <title> <line>...: 0 once A, B, X, Y are tapped in that order. A wrong key, or a pause
# of 5 s, starts it over; power powers off. The screen shows how far it's got.
sequence() {
	_t=$1; shift
	_i=0
	listen
	while :; do
		case $_i in
		0) _p="_ _ _ _" ;; 1) _p="A _ _ _" ;; 2) _p="A B _ _" ;; 3) _p="A B X _" ;;
		esac
		screen "Tapped: $_p" "$_t" "$@"
		_k=$(key 5000)
		[ "$_k" = $POWER ] && off
		case "$_i:$_k" in
		0:$A|1:$B|2:$X) _i=$((_i + 1)) ;;
		3:$Y) return 0 ;;
		*:$A) _i=1 ;;
		*) _i=0 ;;
		esac
	done
}
# disk_of <controller>: the mmcblk disk on it (the SD slot 2a310000.mmc, the eMMC 2a330000.mmc).
disk_of() {
	for _b in /sys/block/mmcblk*; do
		case "$_b" in *boot*|*rpmb*) continue ;; esac
		case "$(readlink -f "$_b")" in */$1/*) echo "${_b##*/}"; return ;; esac
	done
}

screen "Starting..." "!RECOVERY CARD"
i=0
while { [ -z "$(disk_of 2a310000.mmc)" ] || [ -z "$(disk_of 2a330000.mmc)" ]; } && [ $i -lt 100 ]; do
	usleep 100000; i=$((i + 1))
done
CARD=$(disk_of 2a310000.mmc)
EMMC=$(disk_of 2a330000.mmc)
[ -n "$CARD" ] || stop "The card was removed."
[ -n "$EMMC" ] || stop "The built-in storage wasn't found."
[ -b /dev/${CARD}p1 ] || usleep 500000
mount -t vfat -o ro /dev/${CARD}p1 /card || stop "This recovery card is damaged. Make a new one." "the card's partition doesn't mount"

# The backup this card was made with: by region in backup/, described in recovery/backup.info
# (each region's start, sectors and MD5: R0 the partition table, R1 the bootloader, R2 p1, R3 p2).
BK=/card/backup
[ -f /card/recovery/backup.info ] || stop "This recovery card is damaged. Make a new one." "no recovery/backup.info"
info() { sed -n "s/^$1=//p" /card/recovery/backup.info | head -1; }
NAME=$(info NAME) WANT_CID=$(info EMMC_CID) WANT_SECTORS=$(info EMMC_SECTORS) WHEN=$(info DATE) WHAT=$(info STOCK)
[ -n "$NAME" ] && [ -n "$WANT_SECTORS" ] || stop "This recovery card is damaged. Make a new one." "recovery/backup.info is incomplete"
[ -n "$(info R3_START)" ] || stop "This card is from an older setup. Make a new one." "recovery/backup.info has no R3 (an older setup)"
for r in 0 1 2 3; do
	_s=$(info R${r}_START) _n=$(info R${r}_SECTORS) _m=$(info R${r}_MD5)
	case "$_s:$_n" in *[!0-9:]*|:*|*:) stop "This recovery card is damaged. Make a new one." "recovery/backup.info R$r is damaged" ;; esac
	case "$_m" in *[!0-9a-f]*) _m="" ;; esac
	[ ${#_m} -eq 32 ] || stop "This recovery card is damaged. Make a new one." "recovery/backup.info R$r has no MD5"
	eval "R${r}_START=$_s R${r}_SECTORS=$_n R${r}_MD5=$_m"
done
[ -f "$BK/$NAME.0-partition-table.img" ] && [ -f "$BK/$NAME.2-p1.img.zst.001" ] && [ -f "$BK/$NAME.3-p2.img.zst.001" ] ||
	stop "This recovery card is damaged. Make a new one." "the backup's images aren't all in backup/ ($NAME)"
SECTORS=$(cat /sys/block/$EMMC/size)
CID=$(cat /sys/block/$EMMC/device/cid)
[ "$CID" = "$WANT_CID" ] || stop "This backup is from another device." "backup of eMMC $WANT_CID; this one is $CID"
[ "$SECTORS" = "$WANT_SECTORS" ] || stop "This backup doesn't match this device." "backup of $WANT_SECTORS sectors; this storage is $SECTORS"
# Where it writes: the partition table at sectors 0..63, then the bootloader (never written), p1
# and p2, back to back to the end of the storage. p1 and p2 start on a 4 MiB boundary (the writes'
# block), past the Rockchip loader area (sectors 64..32767), and where the backup's own partition
# table puts them: the restore never writes anywhere else, the bootloader above all.
mbr() { od -An -tu4 -j "$1" -N4 "$BK/$NAME.0-partition-table.img" | tr -d ' \n'; }  # a little-endian u32
[ "$R0_START" = 0 ] && [ "$R0_SECTORS" = 64 ] && [ "$R1_START" = 64 ] &&
	[ $((R1_START + R1_SECTORS)) -eq "$R2_START" ] && [ $((R2_START + R2_SECTORS)) -eq "$R3_START" ] &&
	[ $((R3_START + R3_SECTORS)) -eq "$SECTORS" ] && [ "$R2_START" -ge 32768 ] &&
	[ $((R2_START % 8192)) -eq 0 ] && [ $((R3_START % 8192)) -eq 0 ] &&
	[ "$(mbr 454)" = "$R2_START" ] && [ "$(mbr 458)" = "$R2_SECTORS" ] &&
	[ "$(mbr 470)" = "$R3_START" ] && [ "$(mbr 474)" = "$R3_SECTORS" ] ||
	stop "This backup doesn't match this device." "the backup's regions aren't laid out as a restore can write them (backup.info against its partition table)"

# progress <disk> <stat field> <sectors> <heading> <status> <after>: the share of <sectors> that
# <disk> has read (field 3) or written (7) since it started, as "<status> N %<after>", on the
# screen every 2 s until killed, so a step of minutes is seen moving.
progress() {
	_base=$(awk -v f=$2 '{ print $f }' /sys/block/$1/stat)
	while sleep 2; do
		_now=$(awk -v f=$2 '{ print $f }' /sys/block/$1/stat)
		_pct=$(( (_now - _base) * 100 / ($3 > 0 ? $3 : 1) ))
		[ $_pct -gt 99 ] && _pct=99
		screen "$5 $_pct %$6" "!$4" "Backup:$TAB$WHEN" "Contains:$TAB$WHAT"
	done
}

screen "Checking the backup..." "!RECOVERY CARD" "Backup:$TAB$WHEN" "Contains:$TAB$WHAT"
# Each region it writes: whole (its size in bytes) and as it was made (its MD5). A short region
# would be written short, the rest of the storage left as it is.
region_ok() {  # region_ok <n> <file or piece prefix> <raw|zst>
	eval "_m=\$R${1}_MD5 _b=\$((R${1}_SECTORS * 512))"
	rm -f /tmp/count; mkfifo /tmp/count
	wc -c < /tmp/count > /tmp/count.out & _c=$!
	if [ "$3" = raw ]; then _g=$(tee /tmp/count < "$2" | md5sum | cut -c1-32)
	else _g=$(cat "$2".* | zstd -dcq | tee /tmp/count | md5sum | cut -c1-32); fi
	wait $_c
	[ "$_g" = "$_m" ] && [ "$(tr -d ' \n' < /tmp/count.out)" = "$_b" ]
}
# How far it has got: the card's sectors read against the size of what's checked (its first read
# of them since power-on, so all of it comes from the card).
progress $CARD 3 $(( $(du -ck "$BK/$NAME".[023]-* | tail -1 | cut -f1) * 2 )) "RECOVERY CARD" "Checking the backup:" "" & P=$!
region_ok 0 "$BK/$NAME.0-partition-table.img" raw &&
	region_ok 2 "$BK/$NAME.2-p1.img.zst" zst &&
	region_ok 3 "$BK/$NAME.3-p2.img.zst" zst
_rc=$?
kill $P 2>/dev/null; wait $P 2>/dev/null
[ $_rc -eq 0 ] ||
	stop "The backup on this card is damaged. Make a new card." "the backup doesn't read as it was made (MD5 or size)"
log "backup $NAME checks out"

# Enough charge for a write of about 15 GB: 30 %, or the charger in.
power_ok() {
	_cap="" _chg=""
	for _p in /sys/class/power_supply/*; do
		case "$(cat $_p/type 2>/dev/null)" in
		Battery)
			_cap=$(cat $_p/capacity 2>/dev/null)
			case "$(cat $_p/status 2>/dev/null)" in Charging|Full) _chg=1 ;; esac ;;
		*) [ "$(cat $_p/online 2>/dev/null)" = 1 ] && _chg=1 ;;
		esac
	done
	[ -n "$_chg" ] || [ -z "$_cap" ] || [ "$_cap" -ge 30 ]
}


# region_md5 <start> <sectors>: the MD5 of that region of the eMMC, read past the page cache's
# leftovers (drop_caches first).
region_md5() {
	dd if=/dev/$EMMC bs=4M skip=$(($1 / 8192)) count=$(( ($2 + 8191) / 8192 )) 2>/dev/null |
		head -c $(($2 * 512)) | md5sum | cut -c1-32
}

# write_region <n> <file pattern>: a p1/p2 region back at its sector, its MD5 taken on the way.
write_region() {
	eval "_s=\$R${1}_START _m=\$R${1}_MD5"
	rm -f /tmp/fifo /tmp/w.md5; mkfifo /tmp/fifo
	md5sum < /tmp/fifo | cut -c1-32 > /tmp/w.md5 & M=$!
	cat $2 | zstd -dcq | tee /tmp/fifo | dd of=/dev/$EMMC bs=4M seek=$((_s / 8192)) conv=fsync 2>/tmp/dd.err
	_rc=$?
	wait $M
	[ $_rc -eq 0 ] || { FAIL="Writing stopped."; log "the write stopped ($(tail -1 /tmp/dd.err 2>/dev/null))"; return 1; }
	[ "$(cat /tmp/w.md5)" = "$_m" ] || { FAIL="The backup is damaged."; log "the backup didn't decompress as it was made (MD5)"; return 1; }
}

restore() {
	# The partition table, then p1 and p2. Never the bootloader (R1).
	dd if="$BK/$NAME.0-partition-table.img" of=/dev/$EMMC bs=512 seek=$R0_START count=$R0_SECTORS conv=fsync 2>/dev/null ||
		{ FAIL="Writing stopped."; log "the partition table didn't write"; return 1; }
	progress $EMMC 7 $((R2_SECTORS + R3_SECTORS)) RESTORING "Restoring:" ". Don't turn off." & P=$!
	write_region 2 "$BK/$NAME.2-p1.img.zst.*" && write_region 3 "$BK/$NAME.3-p2.img.zst.*"
	_rc=$?
	kill $P 2>/dev/null; wait $P 2>/dev/null
	sync
	[ $_rc -eq 0 ] || return 1
	# Read back, past the page cache: everything that was written.
	echo 3 > /proc/sys/vm/drop_caches
	progress $EMMC 3 $((R2_SECTORS + R3_SECTORS)) RESTORING "Checking what was written:" ". Don't turn off." & P=$!
	_g0=$(dd if=/dev/$EMMC bs=512 skip=$R0_START count=$R0_SECTORS 2>/dev/null | md5sum | cut -c1-32)
	_g2=$(region_md5 $R2_START $R2_SECTORS)
	_g3=$(region_md5 $R3_START $R3_SECTORS)
	kill $P 2>/dev/null; wait $P 2>/dev/null
	[ "$_g0" = "$R0_MD5" ] && [ "$_g2" = "$R2_MD5" ] && [ "$_g3" = "$R3_MD5" ] ||
		{ FAIL="The storage didn't check out after writing."; log "the storage doesn't read back as the backup (MD5)"; return 1; }
	log "eMMC restored and read back"
	# The bootloader, for the record only: it isn't written.
	_l=$(dd if=/dev/$EMMC bs=512 skip=$R1_START count=$R1_SECTORS 2>/dev/null | md5sum | cut -c1-32)
	[ "$_l" = "$R1_MD5" ] && log "the bootloader matches the backup's" || log "the bootloader differs from the backup's (left as it is)"
}

while :; do
	if ! power_ok; then
		screen "Tap power to turn off." "!BATTERY LOW" "Plug in the charger to continue."
		listen
		until power_ok; do [ "$(key 1000)" = $POWER ] && off; done
	fi
	sequence "!RESTORE BUILT-IN STORAGE?" \
		"Backup:$TAB$WHEN" "Contains:$TAB$WHAT" "" \
		"!Everything on it now will be replaced." \
		"Tap A, B, X, Y to restore." \
		"Tap power to turn off."
	FAIL=""
	log "restoring $NAME to $EMMC"
	if restore; then
		screen "Tap power to turn off." "!DONE" "Restored to the backup of $WHEN." \
			"Turn off, remove this card, and turn on."
		listen
		while [ "$(key)" != $POWER ]; do :; done
		off
	fi
	log "restore failed: $FAIL"
	sequence "!RESTORE FAILED" "$FAIL Try again before turning off." "" \
		"Tap A, B, X, Y to try again." "Tap power to turn off."
done
