#!/bin/sh
# basedos-vendor: harvest a vendor set from stock's own files, at setup (docs/plan.md, Architecture).
#
#   basedos-vendor build <out dir> [<stock SYSTEM> <stock boot files dir> [<recipe>]]
#
# Writes <out dir>/vendor-<id>/: the kernel Image and stock's DTBs as plain files, and
# vendor.squashfs with the kernel's modules, the firmware and the closed GPU drivers. The stock
# source defaults to stock's own boot partition on the eMMC (/boot/SYSTEM, /boot/Image, ...: only
# read); the recipe to this BasedOS's (usr/share/basedos/vendor-recipe, written by the PC build
# from the same harvest: each file's place, mode and SHA-256 and where it is in stock's files).
# Every file's hash is checked, then the id (usr/lib/basedos/vendor-id, the PC build's own
# function), then the packed squashfs (it mounts, it names the id). A different stock build fails
# the hash checks, and nothing is written to <out dir> unless all of it checks out.
#
# Only setup uses this: making an SD card, or a fresh install. Updates never change the vendor
# set; a BasedOS for another stock build is a new base, set up afresh.
export PATH=/usr/bin:/usr/sbin
. /usr/lib/basedos/functions
. /usr/lib/basedos/vendor-id

STAGE=/data/.vendor-build
IMG=/data/.vendor-build.squashfs
MNT=/run/basedos/vendor-stock
CHK=/run/basedos/vendor-check

die() { log "vendor: $*"; echo "basedos-vendor: $*" >&2; cleanup; exit 1; }
cleanup() {
	grep -q " $MNT " /proc/mounts && umount "$MNT"
	grep -q " $CHK " /proc/mounts && umount "$CHK"
	rm -rf "$STAGE" "$IMG"
	[ -n "${_dst:-}" ] && rm -rf "$_dst.new"
}

build() {
	_out=$1 _system=${2:-/boot/SYSTEM} _p1=${3:-/boot} _recipe=${4:-/usr/share/basedos/vendor-recipe}
	[ -d "$_out" ] || die "no folder $_out"
	[ -s "$_recipe" ] || die "no recipe at $_recipe"
	_want=$(sed -n 's/^VENDOR_ID=//p' "$_recipe")
	_stock=$(sed -n 's/^STOCK_BUILD=//p' "$_recipe")
	[ -n "$_want" ] || die "$_recipe names no VENDOR_ID"
	[ -e "$_out/vendor-$_want" ] && die "$_out/vendor-$_want is there already"
	[ -f "$_system" ] || die "no stock image at $_system"
	say "harvesting the vendor set from stock ($_stock)"

	mkdir -p "$MNT"
	mount -t squashfs -o ro,loop "$_system" "$MNT" || die "$_system does not mount"
	rm -rf "$STAGE" "$IMG"
	mkdir -p "$STAGE"
	_n=0
	# F <mode> <sha256> <path in the set> <where in stock: a SYSTEM path, or p1:<name>>; L <path> <target>
	while read -r _k _a _b _c _d; do
		case "$_k" in
		F)
			case "$_d" in p1:*) _src=$_p1/${_d#p1:} ;; *) _src=$MNT/$_d ;; esac
			mkdir -p "$STAGE/${_c%/*}"
			cp "$_src" "$STAGE/$_c" 2>/dev/null || die "stock has no $_d (another stock build than $_stock?)"
			[ "$(sha256sum < "$STAGE/$_c" | cut -c1-64)" = "$_b" ] ||
				die "$_d isn't the file the recipe expects (another stock build than $_stock?)"
			chmod "$_a" "$STAGE/$_c"
			_n=$((_n + 1))
			;;
		L)
			mkdir -p "$STAGE/${_a%/*}"
			ln -s "$_b" "$STAGE/$_a"
			_n=$((_n + 1))
			;;
		esac
	done < "$_recipe"
	umount "$MNT"

	_got=$(vendor_id "$STAGE")
	[ "$_got" = "$_want" ] || die "the files give id $_got, not $_want"
	mkdir -p "$STAGE/usr/share/basedos"
	printf 'VENDOR_ID=%s\nSTOCK_BUILD=%s\n' "$_want" "$_stock" > "$STAGE/usr/share/basedos/vendor-release"
	chmod 755 "$STAGE"

	# Packed as the PC build packs it (tools/wsl/build-rootfs.sh): boot/ (the kernel, the DTBs)
	# stays plain files; the rest goes into vendor.squashfs, checked as the initrd will use it.
	# (-e takes the rest of the line as names to leave out, so it goes last.)
	mksquashfs "$STAGE" "$IMG" -noappend -all-root -comp zstd -Xcompression-level 15 -b 256K -quiet -no-progress -e boot ||
		die "mksquashfs failed"
	sync
	mkdir -p "$CHK"
	mount -t squashfs -o ro,loop "$IMG" "$CHK" || die "the new vendor.squashfs does not mount"
	_rel=$(sed -n 's/^VENDOR_ID=//p' "$CHK/usr/share/basedos/vendor-release" 2>/dev/null)
	umount "$CHK"
	[ "$_rel" = "$_want" ] || die "the packed vendor.squashfs names '$_rel', not $_want"

	# Into <out>/vendor-<id>.new, each file read back, then renamed whole.
	_dst=$_out/vendor-$_want
	rm -rf "$_dst.new"
	mkdir -p "$_dst.new" || die "can't write $_dst.new"
	for _f in "$STAGE"/boot/*; do cp "$_f" "$_dst.new/${_f##*/}" || die "couldn't write $_dst.new/${_f##*/}"; done
	cp "$IMG" "$_dst.new/vendor.squashfs" || die "couldn't write $_dst.new/vendor.squashfs"
	sync
	echo 3 > /proc/sys/vm/drop_caches
	for _f in "$STAGE"/boot/*; do cmp -s "$_f" "$_dst.new/${_f##*/}" || die "$_dst.new/${_f##*/} doesn't read back"; done
	cmp -s "$IMG" "$_dst.new/vendor.squashfs" || die "$_dst.new/vendor.squashfs doesn't read back"
	mv "$_dst.new" "$_dst" && sync || die "couldn't rename $_dst.new"
	log "vendor: harvested vendor-$_want ($_n entries)"
	cleanup
	echo "built $_dst"
}

case "${1:-}" in
build) shift; build "$@" ;;
*) echo "usage: basedos-vendor build <out dir> [<stock SYSTEM> <stock boot files dir> [<recipe>]]" >&2; exit 2 ;;
esac
