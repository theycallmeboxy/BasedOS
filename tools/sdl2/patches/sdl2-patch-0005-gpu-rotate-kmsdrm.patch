+    static int frames, slow;
+    static double sum, worst, frame_sum, period_sum;
+    static Uint64 last_swap;
+    static FILE *out;
+    Uint64 now = SDL_GetPerformanceCounter();
+    double ms;
+
+    if (!KMSDRM_RotationStatsMode()) {
