#!/bin/sh
# basedos-boot: leave BasedOS for stock, for one boot, until asked back, or for good.
#
#   basedos-boot stock-once     reboot into stock once; the boot after is BasedOS again
#   basedos-boot switch-to-stock
#                               stock's boot script back, and a "Return to BasedOS" script in
#                               stock's Ports, which puts BasedOS's back and reboots into it.
#                               BasedOS's files stay, for that.
#   basedos-boot uninstall      stock's boot script back and BasedOS removed: its folder on p1
#                               (basedos/) and its data on p2 (basedos-data/, with the return
#                               script if there is one). Stock is as it was before the install.
#                               Done at the next start, by BasedOS's initrd, when none of these
#                               files are in use; --reboot starts it.
#   basedos-boot status         what boots next
#   ... --reboot                restart once it has worked
#
# The maintenance menu (basedos-menu) and the Start boot key call these.
# install-dev.sh, which installed BasedOS, changed only these: it kept stock's boot.scr as
# basedos/boot.scr.stock and wrote BasedOS's own; stock's SYSTEM, kernel, DTBs and /storage are
# untouched.
#
# Caution, since a wrong boot.scr is the one thing here that can stop the device booting:
# - Every boot.scr written is checked first (a well-formed U-Boot script image; BasedOS's or
#   stock's, as expected; stock's matched against the known stock builds when it can be) and
#   read back from the eMMC after.
# - Each write is <name>.new, synced, re-read and compared, then renamed: a power cut leaves the
#   old or the new file whole.
# - The boot.scr switch is the last step that can fail: everything a switch needs (the return
#   script, BasedOS's saved script) is in place and checked before it, and removals come only
#   after it.
# - Nothing is done unless /boot is the eMMC's p1 and p2 the eMMC's p2.
export PATH=/usr/bin:/usr/sbin
. /usr/lib/basedos/functions

B=/boot/basedos
P2=/run/p2
RETURN_NAME="Return to BasedOS.sh"
KNOWN_STOCK=/usr/share/basedos/stock-boot-scr.sha256

die() { log "boot: $*"; echo "basedos-boot: $*" >&2; exit 1; }

put() {
	cp "$1" "$2.new" || { rm -f "$2.new"; return 1; }
	sync
	echo 3 > /proc/sys/vm/drop_caches
	cmp -s "$1" "$2.new" || { rm -f "$2.new"; return 1; }
	mv "$2.new" "$2" && sync
}

_made_rw=""
rw() {
	grep -q "^/dev/mmcblk0p1 /boot [^ ]* rw" /proc/mounts && return 0
	mount -o remount,rw /boot || die "can't write p1"
	_made_rw=1
}
ro() { sync; [ -n "$_made_rw" ] && mount -o remount,ro /boot; _made_rw=""; }

# scr_kind <file>: basedos, stock or bad. A U-Boot legacy script image (magic 27051956, type 6
# "script", its size as the header says); BasedOS's has rdinit=/basedos/init.
scr_kind() {
	[ -s "$1" ] || { echo bad; return; }
	[ "$(dd if="$1" bs=4 count=1 2>/dev/null | od -An -tx1 | tr -d ' \n')" = 27051956 ] || { echo bad; return; }
	[ "$(dd if="$1" bs=1 skip=30 count=1 2>/dev/null | od -An -tu1 | tr -d ' \n')" = 6 ] || { echo bad; return; }
	_len=$(dd if="$1" bs=1 skip=12 count=4 2>/dev/null | od -An -tu1 | awk '{print (($1*256+$2)*256+$3)*256+$4}')
	[ "$(stat -c %s "$1")" -eq $((_len + 64)) ] || { echo bad; return; }
	if dd if="$1" bs=64 skip=1 2>/dev/null | grep -q "rdinit=/basedos/init"; then echo basedos; else echo stock; fi
}

# check_stock <file>: 0 if it's a stock script; says whether it's a known stock build.
check_stock() {
	[ "$(scr_kind "$1")" = stock ] || return 1
	if grep -q "^$(sha256sum < "$1" | cut -c1-64)" "$KNOWN_STOCK" 2>/dev/null; then
		log "boot: $1 is a known stock build's boot.scr"
	else
		log "boot: $1 is a stock-looking boot.scr but not a known stock build's (stock updated?)"
	fi
}

# The device's own partitions, nothing else.
check_places() {
	grep -q "^/dev/mmcblk0p1 /boot " /proc/mounts || die "/boot isn't the eMMC's p1"
	[ -d $B ] || die "no $B"
	grep -q "^/dev/mmcblk0p2 $P2 " /proc/mounts || die "the eMMC's p2 isn't mounted at $P2"
}

# The folders stock's Ports system reads, on this device's p2 (stock's /storage). Stock reads them
# from the eMMC also with a spruce card in (it mounts the card apart, at games-external).
stock_ports_dirs() { echo "$P2/roms/ports"; }

# The script stock runs from its Ports menu to come back. Written by switch-to-stock; it removes
# every copy of itself once it has put BasedOS's boot script back. It runs on stock (bash and
# BusyBox; no cmp), so it checks with md5sum and od.
return_script() {
	cat <<'EOF'
#!/bin/bash
# Return to BasedOS: written by BasedOS when you switched to stock (basedos-boot switch-to-stock).
# Puts BasedOS's boot script back and restarts into BasedOS. To remove BasedOS instead, return
# to it and choose "Uninstall BasedOS" in its maintenance mode (hold Select at power-on).
P1=/flash
SAVED=$P1/basedos/boot.scr.basedos
fail() { echo "Return to BasedOS: $*" >&2; echo "Still stock; nothing changed." >&2; sleep 6; exit 1; }
[ -f "$SAVED" ] || fail "BasedOS's boot script isn't there ($SAVED)."
[ "$(dd if="$SAVED" bs=4 count=1 2>/dev/null | od -An -tx1 | tr -d ' \n')" = 27051956 ] ||
	fail "$SAVED isn't a boot script."
dd if="$SAVED" bs=64 skip=1 2>/dev/null | grep -q "rdinit=/basedos/init" || fail "$SAVED isn't BasedOS's."
[ -f $P1/basedos/initrd.uimg ] || fail "BasedOS's files are gone ($P1/basedos/initrd.uimg)."
ls $P1/basedos/rootfs*.squashfs >/dev/null 2>&1 || fail "BasedOS's system image is gone."
ls $P1/basedos/vendor-*.squashfs >/dev/null 2>&1 || fail "BasedOS's vendor layer is gone."
mount -o remount,rw $P1 || fail "can't write $P1."
rm -f $P1/boot.scr.new
if cp "$SAVED" $P1/boot.scr.new && sync && echo 3 > /proc/sys/vm/drop_caches &&
	[ "$(md5sum < "$SAVED")" = "$(md5sum < $P1/boot.scr.new)" ] &&
	mv $P1/boot.scr.new $P1/boot.scr && sync &&
	[ "$(md5sum < "$SAVED")" = "$(md5sum < $P1/boot.scr)" ]; then
	rm -f "$SAVED"
	mount -o remount,ro $P1
	for d in /storage/roms/ports /roms/ports; do rm -f "$d/Return to BasedOS.sh"; done
	sync
	echo "Back to BasedOS: restarting."
	sleep 2
	reboot
else
	rm -f $P1/boot.scr.new
	sync
	mount -o remount,ro $P1
	fail "couldn't write $P1/boot.scr."
fi
EOF
}

stock_once() {
	# The flag must be on p2: /data in RAM (p2 unusable this boot) would lose it.
	grep -q "^/dev/mmcblk0p2 /data " /proc/mounts || die "/data isn't on the eMMC this boot; can't leave the flag"
	: > /data/boot-stock-once && sync && [ -f /data/boot-stock-once ] || die "couldn't write /data/boot-stock-once"
	log "boot: stock for the next boot"
}

switch_to_stock() {
	check_places
	[ "$(scr_kind /boot/boot.scr)" = basedos ] || die "/boot/boot.scr isn't BasedOS's; nothing to switch"
	check_stock $B/boot.scr.stock || die "$B/boot.scr.stock isn't a stock boot script; not switching"
	# 1. The way back, written and read back before anything that boots changes.
	_n=0
	for _d in $(stock_ports_dirs); do
		mkdir -p "$_d" && return_script > "$_d/$RETURN_NAME.new" && chmod 755 "$_d/$RETURN_NAME.new" &&
			sync && return_script | cmp -s - "$_d/$RETURN_NAME.new" &&
			mv "$_d/$RETURN_NAME.new" "$_d/$RETURN_NAME" && sync && _n=$((_n + 1)) ||
			rm -f "$_d/$RETURN_NAME.new"
	done
	[ $_n -gt 0 ] || die "couldn't write '$RETURN_NAME' in stock's Ports; not switching"
	undo_return() { for _d in $(stock_ports_dirs); do rm -f "$_d/$RETURN_NAME"; done; sync; }
	rw
	put /boot/boot.scr $B/boot.scr.basedos && [ "$(scr_kind $B/boot.scr.basedos)" = basedos ] ||
		{ ro; undo_return; die "couldn't save BasedOS's boot script; not switching"; }
	# 2. The switch. On a failure, BasedOS's script goes back (put keeps the old file whole until
	# the rename, so boot.scr is one or the other either way).
	put $B/boot.scr.stock /boot/boot.scr && cmp -s $B/boot.scr.stock /boot/boot.scr || {
		cmp -s $B/boot.scr.basedos /boot/boot.scr || put $B/boot.scr.basedos /boot/boot.scr
		rm -f $B/boot.scr.basedos; ro; undo_return
		die "couldn't write stock's boot script; still BasedOS"
	}
	ro
	log "boot: switched to stock (BasedOS's files stay; '$RETURN_NAME' in stock's Ports comes back)"
}

uninstall() {
	check_places
	check_stock $B/boot.scr.stock || die "$B/boot.scr.stock isn't a stock boot script; not uninstalling"
	grep -q "^/dev/mmcblk0p2 /data " /proc/mounts || die "/data isn't on the eMMC this boot; can't leave the flag"
	# The removal itself happens at the restart, in BasedOS's initrd, before anything is mounted
	# from these files: removing a running system's files leaves them half freed (stock's fsck
	# then finds them as FSCK*.REC on p1) and some can't go at all (/etc/passwd, bound from
	# /data). Here: everything checked, and the flag left with the SHA-256 of the stock boot
	# script that was checked, which the initrd puts back only if it's still that file.
	_sha=$(sha256sum < $B/boot.scr.stock | cut -c1-64)
	echo "$_sha" > /data/uninstall.new && sync && mv /data/uninstall.new /data/uninstall && sync &&
		[ "$(head -c 64 /data/uninstall)" = "$_sha" ] || { rm -f /data/uninstall /data/uninstall.new; die "couldn't leave the uninstall flag"; }
	rm -f /data/boot-stock-once
	log "boot: uninstall at the next start (stock's boot script back, then basedos/ and basedos-data/ removed)"
}

status() {
	case "$(scr_kind /boot/boot.scr)" in
	basedos)
		if [ -f /data/uninstall ]; then echo "next boot: BasedOS UNINSTALLS itself, then stock"
		else echo "next boot: BasedOS$( [ -f /data/boot-stock-once ] && echo ", except: stock once")"; fi ;;
	stock) echo "next boot: stock (BasedOS switched off; '$RETURN_NAME' in stock's Ports comes back)" ;;
	*) echo "next boot: /boot/boot.scr DOESN'T LOOK LIKE A BOOT SCRIPT" ;;
	esac
	if check_stock $B/boot.scr.stock; then echo "stock's boot script: saved"; else echo "stock's boot script: NOT saved or not valid"; fi
}

case "${1:-}" in
stock-once) stock_once ;;
switch-to-stock) switch_to_stock ;;
uninstall) uninstall ;;
status) status; exit 0 ;;
*) echo "usage: basedos-boot stock-once|switch-to-stock|uninstall|status [--reboot]" >&2; exit 2 ;;
esac
if [ "${2:-}" = --reboot ]; then
	say "restarting"
	reboot
fi
