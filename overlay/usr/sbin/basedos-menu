#!/bin/sh
# basedos-menu: maintenance mode's menu on the boot screen (frontend-session runs it). It shows
# the version that's installed. Up and Down choose, A runs; the ones that change what boots (an
# update, disable BasedOS, uninstall) want A, B, X, Y tapped in that order, as the recovery card
# does, and any other button goes back. Wi-Fi and SSH
# run beside it as before. Each choice is basedos-boot's (or reboot, poweroff), so the same can
# be done over SSH.
. /usr/lib/basedos/functions

UP=$(button_code up) DOWN=$(button_code down) A=$(button_code a) B=$(button_code b)
X=$(button_code x) Y=$(button_code y)
TAB=$(printf '\t')
ITEMS="stock-once|Boot Stock OS
update|Install update
disable|Disable BasedOS
uninstall|Uninstall BasedOS
reboot|Restart
poweroff|Power off"
N=$(echo "$ITEMS" | wc -l)
sel=1

# draw [status]: the menu, the selected line highlighted; the status line says how to use it
# unless there's something else to say.
draw() {
	_ip=$(ip -4 addr show wlan0 2>/dev/null | sed -n 's/.*inet \([0-9.]*\).*/\1/p' | head -1)
	{
		echo "!MAINTENANCE MODE"
		if [ -n "$_ip" ]; then echo "SSH:${TAB}root@$_ip (no password)"; else echo "SSH:${TAB}waiting for Wi-Fi"; fi
		printf 'Version:\t%s\nBuild:\t%s\n' "$BASEOS_VERSION" "$BASEOS_BUILD"
		echo ""
		_i=0
		echo "$ITEMS" | while IFS='|' read -r _k _label; do
			_i=$((_i + 1))
			if [ $_i = $sel ]; then echo "!> $_label"; else echo "   $_label"; fi
		done
	} > "$SPLASH_INFO"
	splash "${1:-Up/Down: choose    A: select}"
}

# Keys come from one basedos-keys --watch through a FIFO, as on the recovery card: every tap is
# read in order as an event, a quick one too (polling what's held missed taps shorter than its
# interval). listen starts a fresh reader, for the menu and for each confirmation, so presses
# from before it don't count.
KW="" KEYS=/run/basedos/menu-keys
listen() {
	[ -n "$KW" ] && unlisten
	rm -f $KEYS; mkfifo $KEYS
	/usr/bin/basedos-keys --watch > $KEYS 2>/dev/null & KW=$!
	exec 5< $KEYS
}
unlisten() {
	kill $KW 2>/dev/null; wait $KW 2>/dev/null
	exec 5<&-
	rm -f $KEYS
	KW=""
}

# pick <title> <line>... <label>...: a list to choose from, under the title and the lines before the
# first "-" argument; the labels follow it. PICKED is the chosen label's number (from 1), or empty
# when B goes back. Keys come from the menu's reader.
pick() {
	_t=$1; shift
	_pre=""
	while [ $# -gt 0 ] && [ "$1" != - ]; do _pre="$_pre$1
"; shift; done
	shift
	_n=$# _s=1 PICKED=""
	while :; do
		{
			echo "!$_t"
			printf '%s' "$_pre"
			_i=0
			for _l in "$@"; do
				_i=$((_i + 1))
				if [ $_i = $_s ]; then echo "!> $_l"; else echo "   $_l"; fi
			done
		} > "$SPLASH_INFO"
		splash "Up/Down: choose    A: select    B: back"
		_k=""
		read -r -t 1 _k <&5
		case "$_k" in
		"$UP") _s=$((_s > 1 ? _s - 1 : _n)) ;;
		"$DOWN") _s=$((_s < _n ? _s + 1 : 1)) ;;
		"$A") PICKED=$_s; return 0 ;;
		"$B") return 1 ;;
		esac
	done
}

# confirm <question> <line>...: 0 once A, B, X, Y are tapped in that order; 1 on any other button,
# or 10 s without one. The lines say what happens; the status line shows how far it's got.
# (Shell variables are all global: confirm's progress is _tap, never a name run's branches use
# across the call. As _p it replaced the update's file name, and the install found no file.)
confirm() {
	_q=$1; shift
	_i=0
	listen
	while :; do
		case $_i in 0) _tap="_ _ _ _" ;; 1) _tap="A _ _ _" ;; 2) _tap="A B _ _" ;; *) _tap="A B X _" ;; esac
		{
			echo "!$_q"
			printf '%s
' "$@"
			echo ""
			echo "Tap A, B, X, Y to confirm."
			echo "Any other button cancels."
		} > "$SPLASH_INFO"
		splash "Tapped: $_tap"
		_k=""
		read -r -t 10 _k <&5
		case "$_i:$_k" in
		0:$A|1:$B|2:$X) _i=$((_i + 1)) ;;
		3:$Y) unlisten; return 0 ;;
		*) unlisten; return 1 ;;
		esac
	done
}

# run <choice>: does it; on a failure, MSG says so under the menu (basedos-boot changes nothing
# that boots unless every step before the switch worked, and logs why in /data/basedos.log).
MSG=""
run() {
	MSG=""
	case "$1" in
	stock-once)
		draw "Starting stock..."
		basedos-boot stock-once --reboot || MSG="Couldn't start stock." ;;
	update)
		# A .bosupd on the card, picked by hand (older ones too).
		[ -f /run/basedos/data-ok ] || { MSG="Can't update: settings storage unavailable."; return; }
		QUIET=1 /usr/sbin/mount-frontend >/dev/null 2>&1
		_list=$(basedos-update list 2>/dev/null)
		[ -n "$_list" ] || { MSG="No update on the SD card."; return; }
		_labels=$(echo "$_list" | while IFS='|' read -r _p _b _k _w; do
			case "$_k" in
			new) echo "$_b" ;;
			old) echo "$_b  (older or installed before)" ;;
			*) echo "$_b  (can't install: $_w)" ;;
			esac
		done)
		_old_ifs=$IFS; IFS='
'
		# shellcheck disable=SC2086
		pick "Install which update?" "Installed now: $BASEOS_BUILD" "" - $_labels || { IFS=$_old_ifs; return; }
		IFS=$_old_ifs
		_line=$(echo "$_list" | sed -n "${PICKED}p")
		_p=${_line%%|*} _r=${_line#*|} _b=${_r%%|*} _r=${_r#*|} _k=${_r%%|*} _w=${_r#*|}
		[ "$_k" = no ] && { MSG="$_b can't be installed: $_w."; return; }
		confirm "Install $_b?" "It replaces $BASEOS_BUILD, and the device restarts." \
			"If it won't start, stock starts instead. Run setup there to repair BasedOS." || return
		draw "Installing $_b..."
		basedos-update install "$_p"
		[ $? -eq 10 ] && while :; do sleep 3600; done   # installed; the reboot is under way
		MSG="Install failed. BasedOS is unchanged." ;;
	disable)
		confirm "Disable BasedOS?" "The device boots stock instead of BasedOS." "BasedOS stays installed." \
			"To boot it again, run Enable BasedOS from stock's Ports." || return
		draw "Disabling BasedOS..."
		basedos-boot disable --reboot || MSG="Couldn't disable BasedOS." ;;
	uninstall)
		confirm "Uninstall BasedOS?" "Removes BasedOS and its settings. Stock stays as it is." || return
		draw "Uninstalling BasedOS..."
		basedos-boot uninstall --reboot || MSG="Couldn't uninstall BasedOS." ;;
	reboot)
		draw "Restarting..."; reboot ;;
	poweroff)
		draw "Powering off..."; poweroff ;;
	esac
}

# The menu owns the screen from here (udhcpc's script leaves it alone while this file is there).
touch /run/basedos/menu-running
draw
listen
ipdrawn=$(cat /run/basedos/wifi-ip 2>/dev/null)
while :; do
	_k=""
	if ! read -r -t 1 _k <&5; then
		# A timeout, or the reader is gone (no input device left): a new one after a pause.
		kill -0 "$KW" 2>/dev/null || { sleep 1; listen; }
	fi
	case "$_k" in
	"$UP") sel=$((sel > 1 ? sel - 1 : N)); draw "$MSG" ;;
	"$DOWN") sel=$((sel < N ? sel + 1 : 1)); draw "$MSG" ;;
	"$A")
		run "$(echo "$ITEMS" | sed -n "${sel}p" | cut -d'|' -f1)"
		draw "$MSG"
		listen ;;
	esac
	# The address appears once Wi-Fi is up (udhcpc's script writes it there).
	ipnow=$(cat /run/basedos/wifi-ip 2>/dev/null)
	[ "$ipnow" != "$ipdrawn" ] && { ipdrawn=$ipnow; draw "$MSG"; }
done
