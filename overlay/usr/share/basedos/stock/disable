#!/bin/bash
# disable: "Disable BasedOS" in BasedOS's menu on stock (Ports > BasedOS: menu, or a setup card's
# basedos-setup.sh --screen), while BasedOS is on (stock started once from it, or just after setup),
# from BasedOS's system layer, with BasedOS's screens (screen.sh). The same as "Disable BasedOS" in
# BasedOS's maintenance menu (basedos-boot disable), and confirmed the same way: stock's own boot
# script goes back in place, so stock starts from now on; BasedOS's files stay, and its menu in
# stock's Ports turns it back on (Enable BasedOS). Stock is running already, so nothing restarts.
# Runs on stock (bash and BusyBox; no cmp, so it checks with md5sum and od).
#
# As careful as basedos-boot: both boot scripts are checked first (whole script images, BasedOS's
# and stock's as expected), the menu's Ports entry is in place and BasedOS's script saved and read
# back before boot.scr changes, and boot.scr is written as boot.scr.new, read back, then renamed.
. "$UI/screen.sh"
P1=/flash
B=$P1/basedos
# Stock's Ports: games-internal/roms/ports, or p2's own roms/ports when stock's automount bound
# nothing on /storage/roms (its setting "external" with a spruce card in; basedos-boot, Stock's
# Ports). Never the card's.
PORTS=/storage/games-internal/roms/ports
OWN=""
grep -q " /storage/roms " /proc/mounts || OWN=/storage/roms/ports
ENTRY="BasedOS.sh"
# The entries before the menu.
OLD_ENTRIES="Enable BasedOS.sh|Disable BasedOS.sh|Uninstall BasedOS.sh|Return to BasedOS.sh"
# fail <screen text> [<log text>]
fail() {
	echo "Disable BasedOS: ${2:-$1}" >&2
	message "A: back to stock" "!Disable BasedOS" "$1" "" "Nothing was changed."
	screen_off
	exit 1
}
# scr_ok <file>: a whole U-Boot script image: its magic, the type "script", and the size its header
# gives (as basedos-boot checks them).
scr_ok() {
	[ -s "$1" ] || return 1
	[ "$(dd if="$1" bs=4 count=1 2>/dev/null | od -An -tx1 | tr -d ' \n')" = 27051956 ] || return 1
	[ "$(dd if="$1" bs=1 skip=30 count=1 2>/dev/null | od -An -tu1 | tr -d ' \n')" = 6 ] || return 1
	_len=$(dd if="$1" bs=1 skip=12 count=4 2>/dev/null | od -An -tu1 | awk '{print (($1*256+$2)*256+$3)*256+$4}')
	[ "$(wc -c < "$1" | tr -d ' ')" = "$((_len + 64))" ]
}
is_basedos() { dd if="$1" bs=64 skip=1 2>/dev/null | grep -q "rdinit=/basedos/init"; }
# put <src> <dst>: written as <dst>.new, read back, renamed, read back.
put() {
	rm -f "$2.new"
	cp "$1" "$2.new" && sync && echo 3 > /proc/sys/vm/drop_caches &&
		[ "$(md5sum < "$1")" = "$(md5sum < "$2.new")" ] &&
		mv "$2.new" "$2" && sync &&
		[ "$(md5sum < "$1")" = "$(md5sum < "$2")" ] && return 0
	rm -f "$2.new"
	return 1
}

screen_on
scr_ok $P1/boot.scr && is_basedos $P1/boot.scr ||
	fail "BasedOS is already disabled."
scr_ok $P1/boot.scr.stock && ! is_basedos $P1/boot.scr.stock ||
	fail "BasedOS's files are damaged." "stock's saved boot script ($P1/boot.scr.stock) isn't there or isn't whole"
if ! confirm "Disable BasedOS?" "The device boots stock instead of BasedOS." "BasedOS stays installed." \
	"To start it again: Ports > BasedOS > Enable BasedOS."; then
	screen_off
	exit 0
fi
screen "Disabling BasedOS..." "!Disable BasedOS"

# 1. The way back: BasedOS's menu in Ports, from the same system layer as this (its Ports file
# copied it here with this script). It stays either way (it offers Disable while BasedOS is on).
mkdir -p "$PORTS" $OWN || fail "Couldn't disable BasedOS." "can't make $PORTS"
[ -f "$UI/$ENTRY" ] && put "$UI/$ENTRY" "$PORTS/$ENTRY" &&
	{ [ -z "$OWN" ] || put "$UI/$ENTRY" "$OWN/$ENTRY"; } ||
	fail "Couldn't disable BasedOS." "couldn't put BasedOS's menu in stock's Ports"
chmod 755 "$PORTS/$ENTRY" ${OWN:+"$OWN/$ENTRY"}

# 2. BasedOS's boot script saved, then stock's in its place.
mount -o remount,rw $P1 || fail "Couldn't disable BasedOS." "can't write $P1"
if ! put $P1/boot.scr $B/boot.scr.basedos; then
	rm -f $B/boot.scr.basedos; sync; mount -o remount,ro $P1
	fail "Couldn't disable BasedOS." "couldn't save BasedOS's boot script"
fi
if ! put $P1/boot.scr.stock $P1/boot.scr; then
	# boot.scr is one whole file or the other (put renames only once the copy reads back).
	[ "$(md5sum < $B/boot.scr.basedos)" = "$(md5sum < $P1/boot.scr)" ] || put $B/boot.scr.basedos $P1/boot.scr
	rm -f $B/boot.scr.basedos; sync; mount -o remount,ro $P1
	fail "Couldn't disable BasedOS." "couldn't write stock's boot script"
fi
sync
mount -o remount,ro $P1
# The entries from before the menu.
for d in $PORTS $OWN /storage/.config/modules; do
	(IFS='|'; for n in $OLD_ENTRIES; do rm -f "$d/$n"; done)
done
sync
echo "$(date) disable: stock's boot script in place" >> /storage/basedos-data/basedos.log 2>/dev/null
message "A: back to stock" "!BasedOS is disabled" "The device boots stock from now on." "BasedOS stays installed." "" \
	"To start it again: Ports > BasedOS > Enable BasedOS."
screen_off
exit 0
