#!/bin/sh
# Hold power for 5 s: sync, unmount the card and power off cleanly. Runs for the whole session,
# so a hung frontend never leaves the hardware cut (about 10 s on the PMIC) as the only way out.
# Shorter presses are left to the frontend, and so is a shutdown the frontend has already begun
# (spruce's save_poweroff holds /tmp/save_poweroff.lock while it saves and closes the game).
. /usr/lib/basedos/functions
HOLD=5

node=""
for d in /sys/class/input/event*; do
	case "$(cat "$d/device/name" 2>/dev/null)" in
		*pwrkey*) node="/dev/input/${d##*/}"; break ;;
	esac
done
[ -n "$node" ] || { log "no power key node; long-press shutdown disabled"; exit 0; }
log "watching $node (hold ${HOLD} s to power off)"

# Each press writes its own token; the timer only acts if that same press is still held, so a
# quick press-release-press can't inherit an older press's timer.
while :; do
	evtest "$node" 2>/dev/null | while read -r line; do
		case "$line" in
		*"(KEY_POWER), value 1"*)
			token=$(cut -d' ' -f1 /proc/uptime)
			echo "$token" > /run/basedos/pwrkey-held
			( sleep $HOLD
			  [ "$(cat /run/basedos/pwrkey-held 2>/dev/null)" = "$token" ] || exit 0
			  [ -e /tmp/save_poweroff.lock ] && { log "power held, but the frontend is already shutting down"; exit 0; }
			  say "power held ${HOLD} s: shutting down"
			  poweroff ) &
			;;
		*"(KEY_POWER), value 0"*)
			rm -f /run/basedos/pwrkey-held
			;;
		esac
	done
	log "evtest on $node ended; restarting it"
	sleep 1
done
