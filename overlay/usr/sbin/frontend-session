#!/bin/sh
# Respawned by init. Finds the frontend on the card and execs it, with every
# /etc/baseos-release key in the environment. First match wins:
#   System/frontend            (NextUI-style binary, run through ld.so)
#   System/launch_frontend.sh
#   spruce/scripts/runtime.sh  (spruceOS)
#   .tmp_update/updater        (MinUI/NextUI updater)
# spruce comes before .tmp_update because spruce cards also carry a Miyoo
# .tmp_update for other devices.
#
# Boot keys: a button held while powering on picks this boot's action, from
# /data/boot-keys.conf or BasedOS's default (/usr/share/basedos/boot-keys.conf):
#   maintenance        no frontend; SSH and Wi-Fi only (default: Select)
#   frontend <entry>   start <entry> on the card instead of the first match above
#
# With no card, the waiting screen watches the same map: a mapped button held for a second there
# does its maintenance or stock action, without a restart.
#
# Safeguards:
#   - A frontend that exits within 15 s, five times in a row, is not restarted again until
#     the next boot (no hot loop draining the battery and writing to the card). BasedOS's own
#     Wi-Fi and SSH come up then, as in maintenance mode, so it can be looked at.
# Wi-Fi and SSH are otherwise the frontend's: BasedOS only loads the Wi-Fi driver at boot.
export PATH=/usr/bin:/usr/sbin
. /usr/lib/basedos/functions
SD=/mnt/SDCARD
STATE=/run/basedos

# BasedOS's own Wi-Fi and SSH, when no frontend will provide them (once a boot).
basedos_network() {
	[ -f $STATE/basedos-network ] && return 0
	touch $STATE/basedos-network
	/etc/init.d/network up
	/etc/init.d/sshd
}

# A frontend that keeps failing: stop, and bring up Wi-Fi and SSH so it can be looked at.
stay_down() {
	say "$1"
	basedos_network
	while :; do sleep 3600; done
}

# run_frontend <entry>: exec one of the card's frontends, the way its kind is started.
run_frontend() {
	case "$1" in
	System/frontend)
		say "starting System/frontend"
		exec /lib/ld-linux-aarch64.so.1 "$SD/System/frontend" > /tmp/frontend.log 2>&1 ;;
	spruce/scripts/runtime.sh)
		say "starting spruce"
		exec /bin/sh "$SD/$1" ;;
	*.sh|.tmp_update/updater)
		say "starting $1"
		exec /bin/sh "$SD/$1" ;;
	*)
		say "starting $1"
		exec "$SD/$1" ;;
	esac
}

# First session of this boot only: the boot keys (read once, a few ms; the choice holds for
# the whole boot, respawns included).
if [ ! -f $STATE/session-checked ]; then
	touch $STATE/session-checked
	act=$(boot_key_action)
	set -- $act
	case "$2" in
	"") ;;
	maintenance)
		touch $STATE/maintenance
		log "$(button_label "$1") held at boot: maintenance mode" ;;
	stock)
		log "$(button_label "$1") held at boot: stock for this boot"
		# reboot only asks init and returns 0: on success, wait for it here.
		basedos-boot stock-once --reboot ||
			stay_down "couldn't hand over to stock (basedos-boot stock-once failed; see /data/basedos.log)"
		while :; do sleep 3600; done ;;
	frontend)
		if [ -n "$3" ]; then
			echo "$3" > $STATE/frontend-choice
			log "$(button_label "$1") held at boot: frontend $3"
		else
			log "$(button_label "$1") held at boot: 'frontend' without an entry in $(boot_keys_conf)"
		fi ;;
	*)
		log "$(button_label "$1") held at boot: unknown action '$2' in $(boot_keys_conf)" ;;
	esac
fi
if [ -f $STATE/maintenance ]; then
	log "maintenance mode: no frontend; SSH is up once Wi-Fi is"
	maintenance_screen
	basedos_network &
	# The menu on the boot screen (stock once, switch to stock, uninstall, restart, power off).
	/usr/sbin/basedos-menu
	log "basedos-menu exited ($?); maintenance mode stays up"
	while :; do sleep 3600; done
fi

# How long did the last frontend run? Five short runs in a row stop the respawning.
if [ -f $STATE/session-start ]; then
	ran=$(( $(cut -d. -f1 /proc/uptime) - $(cat $STATE/session-start) ))
	short=$(cat $STATE/short-exits 2>/dev/null || echo 0)
	if [ "$ran" -lt 15 ]; then short=$((short + 1)); else short=0; fi
	echo "$short" > $STATE/short-exits
	log "frontend exited after ${ran} s (short exits in a row: $short)"
	[ "$short" -ge 5 ] &&
		stay_down "the frontend keeps exiting (5 times within 15 s); not restarting it. Logs: /data/basedos.log and the card. Reboot to try again."
fi

# now_cs: the uptime in hundredths of a second.
now_cs() { read -r _u _ < /proc/uptime; _s=${_u%.*} _f=${_u#*.}; echo $(( _s * 100 + 1$_f - 100 )); }

# waiting_screen: no card: what to do, and the buttons that work here.
waiting_screen() {
	{
		echo "!NO CARD"
		echo "Insert your frontend card."
		grep -v '^[[:space:]]*\(#\|$\)' "$(boot_keys_conf)" 2>/dev/null | while read -r _b _a _arg; do
			button_code "$_b" >/dev/null || continue
			case "$_a" in
			maintenance) echo "!Hold $(button_label "$_b"): maintenance mode" ;;
			stock) echo "!Hold $(button_label "$_b"): start stock once" ;;
			esac
		done | head -3
	} > "$SPLASH_INFO"
	say "no card in the slot (waiting for one)"
}

# key_watch: about a second of watching the boot-key map; a mapped button held for a second does
# its maintenance or stock action (the frontend action needs a card: not here).
_kw="" _kw_t=0
key_watch() {
	_end=$(( $(now_cs) + 100 ))
	while [ "$(now_cs)" -lt $_end ]; do
		set -- $(boot_key_action)
		if [ -z "${1:-}" ] || [ "$1 $2" != "$_kw" ]; then
			_kw=${1:+$1 $2} _kw_t=$(now_cs)
		elif [ $(( $(now_cs) - _kw_t )) -ge 100 ]; then
			case "$2" in
			maintenance)
				touch $STATE/maintenance
				log "$(button_label "$1") held with no card: maintenance mode"
				exit 1 ;;
			stock)
				log "$(button_label "$1") held with no card: stock for this boot"
				basedos-boot stock-once --reboot ||
					stay_down "couldn't hand over to stock (basedos-boot stock-once failed; see /data/basedos.log)"
				while :; do sleep 3600; done ;;
			esac
		fi
		usleep 100000
	done
}

# Quiet retries; one message per session, and only after 15 s without a card (at boot the card is
# usually a few tens of ms from being probed, so the first 2 s are polled every 50 ms). From then
# on the waiting screen stays up and the boot-key map is watched while the card is polled.
i=0
waiting=""
[ -f /run/basedos/said-nocard ] && waiting=1
until QUIET=1 /usr/sbin/mount-frontend 2>/dev/null; do
	i=$((i + 1))
	if [ -n "$waiting" ] || [ $i -ge 66 ]; then
		[ -f /run/basedos/said-nocard ] || { waiting_screen; touch /run/basedos/said-nocard; }
		waiting=1
		key_watch
		continue
	fi
	if [ $i -le 40 ]; then sleep 0.05; else sleep 0.5; fi
done
rm -f /run/basedos/said-nocard

# System updates, once a boot, now that the card is here (.bosupd at its root, as spruce's updater
# leaves them): settle the last one, then install a new one and reboot into it. Only with /data on
# p2 (the update's record lives there).
if [ ! -f $STATE/updates-checked ]; then
	touch $STATE/updates-checked
	if [ -f $STATE/data-ok ]; then
		/usr/sbin/basedos-update confirm
		/usr/sbin/basedos-update apply
		# 10: installed, and the reboot is under way (init stops this session).
		[ $? -eq 10 ] && while :; do sleep 3600; done
	fi
fi

cd "$SD" || exit 1
mark frontend
cut -d. -f1 /proc/uptime > $STATE/session-start
# A boot key's frontend first, when the card has it.
choice=$(cat $STATE/frontend-choice 2>/dev/null)
if [ -n "$choice" ]; then
	case "$choice" in
	/*|*..*) log "boot key frontend '$choice' must be a path inside the card; ignored" ;;
	*) [ -f "$choice" ] && run_frontend "$choice"
	   log "boot key frontend $choice isn't on the card; starting the usual one" ;;
	esac
fi
for entry in System/frontend System/launch_frontend.sh spruce/scripts/runtime.sh .tmp_update/updater; do
	[ -f "$entry" ] && run_frontend "$entry"
done
say "no frontend on the card; retrying in 5 s"
sleep 5
exit 1
