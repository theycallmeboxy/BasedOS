+    }
+    if (!out) {
+        const char *path = SDL_getenv("SDL_KMSDRM_ROTATION_LOG");
+
+        out = path && *path ? fopen(path, "a") : NULL;
+        if (!out) {
+            out = stderr;
+        }
+    }
+    ms = KMSDRM_Ms(t0, now);
