#!/recovery/busybox sh
# BasedOS recovery card's init (rdinit=/recovery/init; tools/recovery/boot.cmd starts it with the
# device's own stock kernel). It puts the built-in storage (the eMMC) back from the backup on the
# card:
#
#   1. checks, writing nothing: the card's backup (backup/, named in recovery/backup.info) is this
#      device's eMMC (its ID and size), it decompresses to the MD5 recorded when it was made, and
#      the battery has enough charge (or the charger is in);
#   2. shows what it would restore, and restores only once A, B, X and Y are tapped in that order
#      (tapping power powers off, on every screen);
#   3. writes the backup to the eMMC: sector 0 (the partition table) and everything from sector
#      32768 (p1) on. Sectors 64 to 32767, the bootloader, are left as they are: it's what
#      started this card, so it works, and a restore that never touches it can always be tried
#      again from the card. The MD5 of what was decompressed is checked, then what was written is
#      read back and checked against the backup's;
#   4. says so, and powers off when power is tapped: take the card out and the device starts from
#      the eMMC as it was when the backup was made.
#
# Only the eMMC is ever written, and only in step 3. The card is mounted read-only.
R=/recovery
bb=$R/busybox
$bb mkdir -p /proc /sys /dev /run/basedos /card /tmp $R/bin
$bb mount -t proc proc /proc
$bb mount -t sysfs sys /sys
$bb mount -t devtmpfs dev /dev 2>/dev/null
$bb --install -s $R/bin
export PATH=$R/bin:$R
set -o pipefail
log() { echo "recovery: $*" > /dev/kmsg; }

# Linux key codes: the pad's A, B, X, Y (as BasedOS's button_code has them) and the power key.
A=305 B=304 X=307 Y=308 POWER=116
LOADER_END=32768                       # sectors 64..32767 are the bootloader; p1 starts here
INFO=/run/basedos/splash
# screen <status> <line>...: the boot screen, its lines ('!' first: highlighted) and status.
screen() {
	_s=$1; shift
	printf '%s\n' "$@" > $INFO
	$R/basedos-splash "$_s" >/dev/null 2>&1
}
# key [<ms>]: the code of the next key pressed (read as an event, so a quick tap counts), or
# nothing if none within <ms>.
key() { $R/basedos-keys --wait "${1:-0}" 2>/dev/null; }
off() {
	sync
	screen "powering off" "!RECOVERY CARD" "Powering off."
	sleep 1
	poweroff -f
}
# stop <line>...: a screen that only offers power off.
stop() {
	log "$*"
	screen "Tap power to power off" "!RECOVERY CARD" "$@"
	while [ "$(key)" != $POWER ]; do :; done
	off
}
# sequence <title> <line>...: 0 once A, B, X, Y are tapped in that order. A wrong key, or a pause
# of 5 s, starts it over; power powers off. The screen shows how far it's got.
sequence() {
	_t=$1; shift
	_i=0
	while :; do
		case $_i in
		0) _p="_ _ _ _" ;; 1) _p="A _ _ _" ;; 2) _p="A B _ _" ;; 3) _p="A B X _" ;;
		esac
		screen "Tap A B X Y to go on ($_p)   Tap power to power off" "$_t" "$@"
		_k=$(key 5000)
		[ "$_k" = $POWER ] && off
		case "$_i:$_k" in
		0:$A|1:$B|2:$X) _i=$((_i + 1)) ;;
		3:$Y) return 0 ;;
		*:$A) _i=1 ;;
		*) _i=0 ;;
		esac
	done
}
# disk_of <controller>: the mmcblk disk on it (the SD slot 2a310000.mmc, the eMMC 2a330000.mmc).
disk_of() {
	for _b in /sys/block/mmcblk*; do
		case "$_b" in *boot*|*rpmb*) continue ;; esac
		case "$(readlink -f "$_b")" in */$1/*) echo "${_b##*/}"; return ;; esac
	done
}

screen "starting" "!RECOVERY CARD" "Checking the card and the backup..."
i=0
while { [ -z "$(disk_of 2a310000.mmc)" ] || [ -z "$(disk_of 2a330000.mmc)" ]; } && [ $i -lt 100 ]; do
	usleep 100000; i=$((i + 1))
done
CARD=$(disk_of 2a310000.mmc)
EMMC=$(disk_of 2a330000.mmc)
[ -n "$CARD" ] || stop "The card isn't there any more."
[ -n "$EMMC" ] || stop "This device's built-in storage isn't there: nothing to restore to."
[ -b /dev/${CARD}p1 ] || usleep 500000
mount -t vfat -o ro /dev/${CARD}p1 /card || stop "The card's partition doesn't mount."

# The backup this card was made with: its images in backup/, named in recovery/backup.info.
BK=/card/backup
[ -f /card/recovery/backup.info ] || stop "This card has no recovery/backup.info."
info() { sed -n "s/^$1=//p" /card/recovery/backup.info | head -1; }
NAME=$(info NAME) WANT_MD5=$(info IMG_MD5) WANT_REST=$(info REST_MD5) WANT_LOADER=$(info LOADER_MD5)
WANT_CID=$(info EMMC_CID) WANT_SECTORS=$(info EMMC_SECTORS) WHEN=$(info DATE) WHAT=$(info STOCK)
[ -n "$NAME" ] && [ ${#WANT_MD5} -eq 32 ] && [ -n "$WANT_SECTORS" ] || stop "The card's recovery/backup.info is incomplete."
[ ${#WANT_REST} -eq 32 ] || stop "This card was made by an older BasedOS setup." "Make a new recovery card."
[ -f "$BK/$NAME.img.zst.001" ] || stop "The backup's images aren't in backup/ ($NAME)."
SECTORS=$(cat /sys/block/$EMMC/size)
CID=$(cat /sys/block/$EMMC/device/cid)
[ "$CID" = "$WANT_CID" ] || stop "This backup is of another 350H Ultra's storage" "(ID $WANT_CID; this one is $CID)." "Nothing was written."
[ "$SECTORS" = "$WANT_SECTORS" ] || stop "The backup is $WANT_SECTORS sectors; this storage is $SECTORS." "Nothing was written."

screen "checking the backup (a few minutes)" "!RECOVERY CARD" "Backup of $WHEN" "$WHAT" "Checking the backup..."
[ "$(cat "$BK/$NAME.img.zst."* | zstd -dcq | md5sum | cut -c1-32)" = "$WANT_MD5" ] ||
	stop "The backup on this card is damaged or incomplete" "(it doesn't decompress to what was backed up)." "Nothing was written."
log "backup $NAME checks out"

# Enough charge for a write of about 15 GB: 30 %, or the charger in.
power_ok() {
	_cap="" _chg=""
	for _p in /sys/class/power_supply/*; do
		case "$(cat $_p/type 2>/dev/null)" in
		Battery)
			_cap=$(cat $_p/capacity 2>/dev/null)
			case "$(cat $_p/status 2>/dev/null)" in Charging|Full) _chg=1 ;; esac ;;
		*) [ "$(cat $_p/online 2>/dev/null)" = 1 ] && _chg=1 ;;
		esac
	done
	[ -n "$_chg" ] || [ -z "$_cap" ] || [ "$_cap" -ge 30 ]
}

# progress <stat field> <what>: the share of the eMMC's sectors read (3) or written (7) since
# it started, on the screen every 2 s, until killed.
progress() {
	_base=$(awk -v f=$1 '{ print $f }' /sys/block/$EMMC/stat)
	while sleep 2; do
		_now=$(awk -v f=$1 '{ print $f }' /sys/block/$EMMC/stat)
		screen "$2: $(( (_now - _base) * 100 / SECTORS )) %  (don't power off)" "!RESTORING" "Backup of $WHEN" "$WHAT"
	done
}

# eMMC_rest: the eMMC as a restore writes it: sector 0 and everything from p1 on.
emmc_rest() {
	dd if=/dev/$EMMC bs=32768 count=1 2>/dev/null
	dd if=/dev/$EMMC bs=4M skip=$((LOADER_END / 8192)) 2>/dev/null
}

restore() {
	# The image, decompressed once: its MD5 taken on the way (all of it), then written in three
	# parts: sectors 0..63 (the partition table), 64..32767 skipped (the bootloader, left as it is),
	# and the rest from p1 on. head -c reads exactly that much from the stream, no more.
	rm -f /tmp/fifo /tmp/w.md5; mkfifo /tmp/fifo
	md5sum < /tmp/fifo | cut -c1-32 > /tmp/w.md5 & M=$!
	progress 7 writing & P=$!
	cat "$BK/$NAME.img.zst."* | zstd -dcq | tee /tmp/fifo | {
		head -c 32768 | dd of=/dev/$EMMC bs=32768 conv=fsync 2>/dev/null &&
			head -c $(( (LOADER_END - 64) * 512 )) > /dev/null &&
			dd of=/dev/$EMMC bs=4M seek=$((LOADER_END / 8192)) conv=fsync 2>/tmp/dd.err
	}
	rc=$?
	wait $M; kill $P 2>/dev/null; wait $P 2>/dev/null
	sync
	[ $rc -eq 0 ] || { FAIL="the write stopped ($(tail -1 /tmp/dd.err 2>/dev/null))"; return 1; }
	[ "$(cat /tmp/w.md5)" = "$WANT_MD5" ] || { FAIL="the backup didn't decompress as it was made (MD5)"; return 1; }
	# Read back, past the page cache: everything that was written.
	echo 3 > /proc/sys/vm/drop_caches
	progress 3 checking & P=$!
	got=$(emmc_rest | md5sum | cut -c1-32)
	kill $P 2>/dev/null; wait $P 2>/dev/null
	[ "$got" = "$WANT_REST" ] || { FAIL="the storage doesn't read back as the backup (MD5)"; return 1; }
	log "eMMC restored and read back: $got"
	# The bootloader, for the record only: it isn't written.
	_l=$(dd if=/dev/$EMMC bs=512 skip=64 count=$((LOADER_END - 64)) 2>/dev/null | md5sum | cut -c1-32)
	[ "$_l" = "$WANT_LOADER" ] && log "the bootloader matches the backup's" || log "the bootloader differs from the backup's (left as it is)"
}

while :; do
	if ! power_ok; then
		screen "Tap power to power off" "!RECOVERY CARD" "The battery is low: plug in the charger" "(it carries on once it's charging)."
		until power_ok; do [ "$(key 1000)" = $POWER ] && off; done
	fi
	sequence "!RESTORE THE BUILT-IN STORAGE" \
		"Backup of $WHEN" "$WHAT" \
		"This puts the built-in storage back as it was then:" \
		"EVERYTHING ON IT NOW IS REPLACED." \
		"Tap A, B, X, Y in that order to restore." \
		"Tap power to power off (nothing is written)."
	FAIL=""
	log "restoring $NAME to $EMMC"
	if restore; then
		screen "Tap power to power off" "!DONE" "The built-in storage is back as it was on $WHEN." \
			"Power off, take this card out, and the device" "starts as it was then."
		while [ "$(key)" != $POWER ]; do :; done
		off
	fi
	log "restore failed: $FAIL"
	sequence "!RESTORE FAILED" "$FAIL" \
		"The storage may be incomplete: try again." \
		"Tap A, B, X, Y in that order to try again." "Tap power to power off."
done
