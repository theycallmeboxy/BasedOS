#!/bin/sh
# basedos-menu: maintenance mode's menu on the boot screen (frontend-session runs it). It shows
# what's in each system slot (A/B). Up and Down choose, A runs; the ones that change what boots
# (the other slot, switch to stock, uninstall) want A, B, X, Y tapped in that order, as the
# recovery card does, and any other button goes back. Wi-Fi and SSH
# run beside it as before. Each choice is basedos-boot's (or reboot, poweroff), so the same can
# be done over SSH.
. /usr/lib/basedos/functions

UP=$(button_code up) DOWN=$(button_code down) A=$(button_code a) B=$(button_code b)
X=$(button_code x) Y=$(button_code y)
# The slots, read once: nothing here changes them without restarting.
SLOTS="$(slot_line a)
$(slot_line b)"
OTHER=b; [ "$(next_slot)" = b ] && OTHER=a
OTHER_S=$(echo "$OTHER" | tr ab AB)
ITEMS="stock-once|Start stock once (BasedOS again after)
slot|Boot slot $OTHER_S from now on
switch|Switch to stock (back from stock's Ports)
uninstall|Uninstall BasedOS
reboot|Restart
poweroff|Power off"
N=$(echo "$ITEMS" | wc -l)
sel=1

held() { echo " $(/usr/bin/basedos-keys 2>/dev/null | tr '\n' ' ') "; }
is_held() { case "$1" in *" $2 "*) return 0 ;; esac; return 1; }

# draw [status]: the menu, the selected line highlighted.
draw() {
	_ip=$(ip -4 addr show wlan0 2>/dev/null | sed -n 's/.*inet \([0-9.]*\).*/\1/p' | head -1)
	{
		echo "!MAINTENANCE MODE"
		echo "ssh root@${_ip:-(waiting for Wi-Fi)}   no password"
		echo "$SLOTS"
		_i=0
		echo "$ITEMS" | while IFS='|' read -r _k _label; do
			_i=$((_i + 1))
			if [ $_i = $sel ]; then echo "!> $_label"; else echo "   $_label"; fi
		done
		echo "Up/Down choose, A select.  BasedOS $BASEOS_VERSION ($BASEOS_BUILD)"
	} > "$SPLASH_INFO"
	splash "${1:-}"
}

# A confirmation's keys come from one basedos-keys --watch through a FIFO, as on the recovery
# card: every tap is read in order, a quick one too, and presses from before it don't count.
KW="" KEYS=/run/basedos/menu-keys
listen() {
	rm -f $KEYS; mkfifo $KEYS
	/usr/bin/basedos-keys --watch > $KEYS 2>/dev/null & KW=$!
	exec 5< $KEYS
}
unlisten() {
	kill $KW 2>/dev/null; wait $KW 2>/dev/null
	exec 5<&-
	rm -f $KEYS
	KW=""
}

# confirm <what>: 0 once A, B, X, Y are tapped in that order; 1 on any other button, or 10 s
# without one. The screen shows how far it's got.
confirm() {
	_i=0
	listen
	while :; do
		case $_i in 0) _p="_ _ _ _" ;; 1) _p="A _ _ _" ;; 2) _p="A B _ _" ;; *) _p="A B X _" ;; esac
		{
			echo "!$1"
			echo "Tap A, B, X, Y in that order to go ahead ($_p)."
			echo "Any other button goes back."
		} > "$SPLASH_INFO"
		splash ""
		_k=""
		read -r -t 10 _k <&5
		case "$_i:$_k" in
		0:$A|1:$B|2:$X) _i=$((_i + 1)) ;;
		3:$Y) unlisten; return 0 ;;
		*) unlisten; return 1 ;;
		esac
	done
}

# run <choice>: does it; on a failure, MSG says so under the menu (basedos-boot changes nothing
# that boots unless every step before the switch worked, and logs why in /data/basedos.log).
MSG=""
run() {
	MSG=""
	case "$1" in
	stock-once)
		draw "starting stock once"
		basedos-boot stock-once --reboot || MSG="couldn't set up stock once: see /data/basedos.log" ;;
	slot)
		# basedos-boot refuses an empty slot or one that wouldn't start, and says why.
		confirm "Boot slot $OTHER_S from now on? The device restarts into it." || return
		draw "switching to slot $OTHER_S"
		_e=$(basedos-boot slot "$OTHER" --reboot 2>&1 >/dev/null) || MSG=${_e#basedos-boot: } ;;
	switch)
		confirm "Switch to stock? BasedOS stays installed; 'Return to BasedOS' in stock's Ports brings it back." || return
		draw "switching to stock"
		basedos-boot switch-to-stock --reboot || MSG="couldn't switch to stock (still BasedOS): see /data/basedos.log" ;;
	uninstall)
		confirm "Uninstall BasedOS? Its files and settings on this device are removed; stock is as before." || return
		draw "uninstalling BasedOS"
		basedos-boot uninstall --reboot || MSG="couldn't uninstall (still BasedOS): see /data/basedos.log" ;;
	reboot)
		draw "restarting"; reboot ;;
	poweroff)
		draw "powering off"; poweroff ;;
	esac
}

# The menu owns the screen from here (udhcpc's script leaves it alone while this file is there).
touch /run/basedos/menu-running
draw
prev=$(held)
ipdrawn=$(cat /run/basedos/wifi-ip 2>/dev/null)
while :; do
	usleep 80000
	now=$(held)
	# A press is a key down now that wasn't before.
	if is_held "$now" "$UP" && ! is_held "$prev" "$UP"; then sel=$((sel > 1 ? sel - 1 : N)); draw "$MSG"
	elif is_held "$now" "$DOWN" && ! is_held "$prev" "$DOWN"; then sel=$((sel < N ? sel + 1 : 1)); draw "$MSG"
	elif is_held "$now" "$A" && ! is_held "$prev" "$A"; then
		run "$(echo "$ITEMS" | sed -n "${sel}p" | cut -d'|' -f1)"
		draw "$MSG"
		now=$(held)
	fi
	prev=$now
	# The address appears once Wi-Fi is up (udhcpc's script writes it there).
	ipnow=$(cat /run/basedos/wifi-ip 2>/dev/null)
	[ "$ipnow" != "$ipdrawn" ] && { ipdrawn=$ipnow; draw "$MSG"; }
done
