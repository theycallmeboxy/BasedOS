#!/bin/sh
# BasedOS shutdown (BusyBox init runs this before reboot/poweroff, and before it signals any
# process itself). Stop everything first, so the frontend and emulators have let go of the
# card and saved, then sync and unmount. A filesystem that still won't unmount is remounted
# read-only instead (vfat clears its dirty bit on a read-only remount); never a lazy unmount,
# which would detach it while writes are still in flight.
. /usr/lib/basedos/functions
log "shutting down"

# SIGTERM to every process except init and this script's own session (killall5 spares those).
killall5 -15
i=0
while [ $i -lt 30 ] && pgrep -f "/mnt/SDCARD/" >/dev/null 2>&1; do sleep 0.1; i=$((i + 1)); done
pgrep -f "/mnt/SDCARD/" >/dev/null 2>&1 && log "frontend still running after 3 s; killing it"
killall5 -9
sync

# Mounts inside a filesystem (spruce bind-mounts its python over the card's MainUI) keep it busy,
# so those go first, deepest first. Killed processes take a moment to let go of their files, so
# each step is retried for up to 3 s before falling back.
retry() {
	n=0
	while [ $n -lt 30 ]; do
		"$@" 2>/dev/null && return 0
		sleep 0.1
		n=$((n + 1))
	done
	return 1
}

# Swap files and loop devices backed by the card or p2 hold them open for writing, so neither would
# unmount nor go read-only: spruce's swap file (/mnt/SDCARD/cachefile), a port's runtime loop-mounted
# outside /mnt/SDCARD (/tmp/weston). Let them go first (spruce's own shutdown does the same; this
# covers the paths around it: the volume-key combo, poweroff or reboot over SSH).
for f in $(awk 'NR > 1 && $2 == "file" { print $1 }' /proc/swaps 2>/dev/null); do
	swapoff "$f" 2>/dev/null || log "swap $f could not be turned off"
done
for l in /sys/block/loop*; do
	b=$(cat "$l/loop/backing_file" 2>/dev/null) || continue
	case "$b" in /mnt/SDCARD/*|/data/*|/run/p2/*) ;; *) continue ;; esac
	d=/dev/${l##*/}
	for mp in $(awk -v d="$d" '$1 == d { print $2 }' /proc/mounts | sort -r); do
		retry umount "$mp" || log "$mp ($b) could not be unmounted"
	done
	retry losetup -d "$d" || log "$d ($b) could not be detached"
done

for m in /mnt/SDCARD /data /run/p2; do
	grep -q " $m " /proc/mounts || continue
	for sub in $(awk -v m="$m/" 'index($2, m) == 1 { print $2 }' /proc/mounts | sort -r); do
		retry umount "$sub" || log "$sub could not be unmounted"
	done
	if retry umount "$m"; then
		continue
	elif retry mount -o remount,ro "$m"; then
		log "$m busy: remounted read-only"
	else
		log "$m could not be unmounted or remounted read-only"
	fi
done
mount -o remount,ro /boot 2>/dev/null
sync

# Finish here when poweroff or reboot said which (/usr/sbin/poweroff): BusyBox init would next
# signal every process again (all stopped above) and pause 2 s in all before doing the same.
case "$(cat /run/basedos/shutdown-action 2>/dev/null)" in
poweroff) /usr/bin/busybox poweroff -f ;;
reboot) /usr/bin/busybox reboot -f ;;
esac
