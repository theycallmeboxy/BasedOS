#!/bin/sh
# udhcpc event script: configure wlan0 and DNS.
case "$1" in
deconfig)
	ifconfig "$interface" 0.0.0.0
	: > /run/basedos/wifi-ip
	;;
bound|renew)
	ifconfig "$interface" "$ip" netmask "${subnet:-255.255.255.0}" ${broadcast:+broadcast $broadcast}
	if [ -n "$router" ]; then
		while route del default gw 0.0.0.0 dev "$interface" 2>/dev/null; do :; done
		for r in $router; do route add default gw "$r" dev "$interface"; break; done
	fi
	: > /run/resolv.conf
	[ -n "$domain" ] && echo "search $domain" >> /run/resolv.conf
	for d in $dns; do echo "nameserver $d" >> /run/resolv.conf; done
	echo "[$(cut -d' ' -f1 /proc/uptime)] udhcpc: $1 $ip on $interface" >> /data/basedos.log
	cut -d' ' -f1 /proc/uptime > /run/basedos/mark-ip
	echo "$ip" > /run/basedos/wifi-ip
	# Maintenance mode's screen shows the address to SSH to; otherwise nothing is drawn (the
	# frontend usually owns the display by now). While its menu runs, the menu owns the screen
	# and redraws itself when /run/basedos/wifi-ip changes (drawing here would cover the menu, or
	# a confirmation it's waiting on).
	if [ -f /run/basedos/maintenance ] && [ ! -f /run/basedos/menu-running ]; then
		. /usr/lib/basedos/functions
		maintenance_screen "Wi-Fi connected"
	fi
	;;
esac
exit 0
