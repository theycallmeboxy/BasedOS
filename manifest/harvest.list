# What BasedOS takes from the stock rootfs (the SYSTEM squashfs of a known build, see
# stock-builds.txt) into the vendor layer: only what can't be BasedOS's own, the closed GPU
# drivers, the Wi-Fi and Bluetooth firmware and the stock kernel's modules
# (docs/vendor-minimal.md). Everything else comes from BasedOS's own build (manifest/base.list).
# One path per line:
#   /stock/path              copied to the same place (a directory recursively; symlinks kept)
#   /stock/path => /dest     copied to a different place
# Libraries that these need (ELF DT_NEEDED) come from the system layer (tools/harvest.py
# --provided); the build fails if one is in neither.

## GPU: libmali (Bifrost G52, Rockchip's g24p0 wayland-gbm build) under the standard names, with
## its own GL API wrappers. Stock bind-mounts these at runtime ("gpudriver"); BasedOS installs
## them directly. It needs only glibc 2.28+, libstdc++, libgcc_s and libwayland (system layer).
/usr/lib/libmali.so.1.9.0
/usr/lib/libmali.so.1
/usr/lib/libmali.so
/usr/lib/libmali-hook.so.1.9.0
/usr/lib/libmali-hook.so.1
/usr/lib/mali/libEGL.so.1 => /usr/lib/libEGL.so.1
/usr/lib/mali/libGLESv1_CM.so.1 => /usr/lib/libGLESv1_CM.so.1
/usr/lib/mali/libGLESv2.so.2 => /usr/lib/libGLESv2.so.2
/usr/lib/mali/libgbm.so.1 => /usr/lib/libgbm.so.1
/usr/lib/mali/libwayland-egl.so.1 => /usr/lib/libwayland-egl.so.1

## GPU: the same driver's 32-bit (armhf) build and its wrappers, for PortMaster's 32-bit ports
## (docs/lib32.md). It needs the same open libraries in 32 bits, from the system layer's
## /usr/lib32 (manifest/base32.list). No 32-bit Vulkan: stock has only Mesa's for armhf.
/usr/lib32/libmali.so.1.9.0
/usr/lib32/libmali.so.1
/usr/lib32/libmali.so
/usr/lib32/libmali-hook.so.1.9.0
/usr/lib32/libmali-hook.so.1
/usr/lib32/mali/libEGL.so.1 => /usr/lib32/libEGL.so.1
/usr/lib32/mali/libGLESv1_CM.so.1 => /usr/lib32/libGLESv1_CM.so.1
/usr/lib32/mali/libGLESv2.so.2 => /usr/lib32/libGLESv2.so.2
/usr/lib32/mali/libgbm.so.1 => /usr/lib32/libgbm.so.1
/usr/lib32/mali/libwayland-egl.so.1 => /usr/lib32/libwayland-egl.so.1

## GPU: Arm's Mali Vulkan driver for the G52, as the Khronos loader's ICD (the loader is
## BasedOS's). spruce's DSperate draws through it: without it, it scales and turns the picture on
## the CPU, too slow on this 1440x1600 portrait panel (2.4 fps; 59 fps with it, 2026-11-16).
## Stock's panfrost_icd json is left out: it names Mesa's PanVK, which BasedOS doesn't carry.
/usr/lib/libMaliVulkan.so.1
/usr/share/vulkan/icd.d/mali.json

## Wi-Fi and Bluetooth: Broadcom AP6256/AP6255 firmware and nvram, and the stock kernel's
## modules (bcmdhd is the one BasedOS loads; they must match the stock kernel BasedOS boots).
/usr/lib/kernel-overlays/base/lib/modules => /usr/lib/modules
/usr/lib/kernel-overlays/base/lib/firmware => /usr/lib/firmware
